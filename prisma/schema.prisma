generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String      @id @default(uuid())
  firstName                 String
  // Legal middle name as printed on the ID. Optional: many Nigerian IDs have
  // none, and Anchor/Fincra KYC match on first + last.
  middleName                String?
  lastName                  String
  businessName              String
  phone                     String?     @unique
  email                     String?     @unique
  password                  String?
  plan                      Plan        @default(FREE)
  role                      Role        @default(USER)
  accountType               AccountType @default(OWNER)
  employerId                String?
  profileImage              String?     @db.Text
  avatarUrl                 String?
  expoPushToken             String?
  country                   String      @default("NG") // ISO 3166-1 alpha-2 — drives currency, language, calling code, KYC, AML
  language                  String      @default("en")
  currency                  String      @default("NGN") // derived from country at write-time
  notificationsEnabled      Boolean     @default(true)
  biometricEnabled          Boolean     @default(false)
  autoDebitEnabled          Boolean     @default(true) // global kill-switch for all recurring auto-debits
  transactionPin            String?
  transactionPinFailedCount Int         @default(0)
  transactionPinLockedUntil DateTime?
  failedLoginAttempts       Int         @default(0)
  lockedUntil               DateTime?
  // Bumped on password change / logout-all; JWTs carry this value and are
  // rejected by authMiddleware once it no longer matches (session revocation).
  tokenVersion              Int         @default(0)
  dateOfBirth               DateTime?
  gender                    String?
  // The code this user typed at signup, i.e. who referred THEM. Stored raw and
  // unvalidated for now; nothing consumes it yet.
  referredByCode            String?
  // Consent records. NDPA treats marketing consent as something that must be
  // evidenced, and terms acceptance is the legal basis for the account, so both
  // are stored rather than assumed from the fact that signup completed.
  marketingOptIn            Boolean   @default(false)
  termsAcceptedAt           DateTime?
  anchorCustomerId          String?     @unique
  fincraCustomerRef         String?
  kycStatus                 String      @default("unverified")
  accountStatus             String      @default("active") // "active" | "restricted" | "frozen" | "closed"
  complianceFreezeReason    String?
  complianceFrozenAt        DateTime?
  complianceFrozenBy        String?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  businesses        Business[]
  customers         Customer[]
  transactions      Transaction[]
  sales             Sales[]
  expenses          Expense[]
  businessDebts     BusinessDebt[]
  suggestions       Suggestion[]
  reminders         Reminder[]
  inventoryItems    InventoryItem[]
  notifications     AppNotification[]
  recurringExpenses RecurringExpense[]
  recurringInvoices RecurringInvoice[]
  kycSubmissions    KycSubmission[]
  // Back-reference only — the FK lives on StaffPermission, so this emits no SQL
  // against User. `employerId` above stays a bare String? on purpose: adding a
  // real FK to it would mean ALTER TABLE "User" on a database shared with
  // another deployed app, and would fail outright on any orphaned row.
  staffPermission   StaffPermission?

  // DECLARED so schema and database agree. The staff-permissions migration
  // creates this index (employerId had been queried unindexed since staff were
  // introduced), but it was never written here — and Prisma treats the schema as
  // the truth. The next `migrate diff` against production would therefore have
  // emitted a DROP INDEX for it, quietly undoing the fix on a database SHARED
  // with another live app. A missing @@index is not cosmetic drift; it is a
  // pending destructive migration.
  @@index([employerId])
}

model AppNotification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

model Business {
  id                         String    @id @default(uuid())
  userId                     String
  user                       User      @relation(fields: [userId], references: [id])
  name                       String
  emoji                      String    @default("🛍️")
  color                      String    @default("#6C3FC5")
  logoUrl                    String?
  receiptFooter              String?
  invoiceTemplate            String    @default("classic")
  bankName                   String?
  bankAccountNumber          String?
  bankAccountName            String?
  usePaymentOverride         Boolean   @default(false)
  riskCategory               String    @default("standard") // "standard" | "elevated" | "high"
  accountStatus              String    @default("active") // "active" | "restricted" | "frozen" | "closed"
  country                    String    @default("NG") // immutable after creation; drives currency + KYC + AML + banking
  baseCurrency               String    @default("NGN") // locked to country; dashboard / cash totals / AML thresholds read this
  kycId                      String? // generic primary KYC identifier (encrypted)
  kycIdType                  String    @default("BVN") // "BVN" | "GhanaCard" | "KE_NID" | "SA_ID" | "EG_NID" | "UG_NIN"
  invoiceCounter             Int       @default(0)
  taxId                      String? // display-only Tax ID / RC number for documents (P&L, invoices)
  virtualAccountRef          String?
  virtualAccountId           String?
  // @unique: one NUBAN belongs to exactly one business. Without this, the
  // sync-anchor-account hatch could clone one KYC-verified account onto many
  // businesses, each then resolving to its OWN full AML tier limits on the same
  // real account (an N× multiplication of the regulator-facing cap).
  virtualAccountNumber       String?   @unique
  virtualAccountBank         String?
  virtualAccountName         String?
  anchorAccountId            String?   @unique
  // Provider-neutral banking identity (Fincra swap). New code gates "has
  // banking" on providerAccountId instead of anchorAccountId.
  providerAccountId          String?   @unique
  paymentProviderRef         String?
  localAccountStatus         String?   @default("none") // none | pending | issued
  bankAccountType            String    @default("SAVINGS")
  kycBvn                     String?
  kycCacNumber               String?
  // HMAC-SHA-256 fingerprints of the encrypted identifiers above. Searchable,
  // irreversible — used for dedup ("has anyone else registered this BVN/CAC")
  // and for the KycCheckCache lookup. See server/src/utils/crypto.js hmacValue().
  kycBvnHash                 String?   @db.VarChar(64)
  kycCacHash                 String?   @db.VarChar(64)
  kycBusinessType            String?   @default("sole_proprietor")
  cacCertificateUrl          String?
  description                String?
  industry                   String?
  registrationType           String?
  dateOfRegistration         DateTime?
  dateOfIncorporation        DateTime?
  addressState               String?
  addressLine1               String?
  addressLine2               String?
  addressCity                String?
  addressPostalCode          String?
  directorAddressSame        Boolean   @default(true)
  directorAddressLine1       String?
  directorAddressState       String?
  directorAddressCity        String?
  // ── Instagram (per-business OAuth connection — Path A: Instagram Login) ───
  // The merchant connects their IG Professional account (Instagram Login, no
  // Facebook Page) so they can read/reply to DMs and send their NUBAN payment
  // details from inside KashBook. The token is a long-lived (~60d) IG User
  // token, refreshed by a cron, stored ENCRYPTED at rest (enc:v1:… via
  // utils/crypto.encrypt). The id/username are plaintext. Tokens are
  // per-Business (one user may own several businesses / IG accounts).
  // See docs/INSTAGRAM_API_SPEC.md for the verified Meta contracts.
  instagramAccessToken       String? // encrypt()-ed long-lived token — never returned to the client
  // @unique: one IG account ↔ one business. Webhook routing is by this id, so a
  // duplicate would make routing ambiguous. Nullable-unique → Postgres allows
  // many NULLs (un-connected businesses) but rejects a second claim of the same
  // id, closing the connect-callback TOCTOU race (caught as P2002).
  instagramBusinessAccountId String?   @unique // the merchant's IG account id (IGID)
  instagramUsername          String? // @handle, for display
  igTokenExpiresAt           DateTime?
  igConnectionStatus         String?   @default("disconnected") // "disconnected" | "connected" | "expired" | "error"
  igWebhookSubscribed        Boolean   @default(false) // did me/subscribed_apps succeed? if false, inbound DMs won't arrive
  // ── WhatsApp Business (Cloud API — Embedded Signup) ───────────────────────
  // Per-merchant WABA connection mirroring the Instagram block above. The token
  // is a business-scoped token (NO expiry — no refresh cron), stored encrypted.
  // waPhoneNumberId is the webhook routing key. See docs/WHATSAPP_API_SPEC.md.
  waAccessToken              String? // encrypt()-ed business token — never returned to clients
  wabaId                     String? // WhatsApp Business Account id
  waPhoneNumberId            String?   @unique // Cloud API phone-number id (routing key)
  waPhoneNumber              String? // display number, e.g. +23480…
  waConnectionStatus         String?   @default("disconnected") // "disconnected" | "connected" | "error"
  waWebhookSubscribed        Boolean   @default(false)
  // VAT summary settings. Off by default (most micro-traders aren't VAT-
  // registered). vatRate null → country default. vatInclusive: are recorded
  // amounts treated as VAT-inclusive (true, NG default) or exclusive.
  vatEnabled                 Boolean   @default(false)
  vatRate                    Float?
  vatInclusive               Boolean   @default(true)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  transactions      Transaction[]
  sales             Sales[]
  expenses          Expense[]
  businessDebts     BusinessDebt[]
  customCategories  CustomCategory[]
  inventoryItems    InventoryItem[]
  customers         Customer[]
  reminders         Reminder[]
  payables          Payable[]
  invoices          Invoice[]
  recurringExpenses RecurringExpense[]
  recurringInvoices RecurringInvoice[]
  officers          BusinessOfficer[]
  beneficiaries     Beneficiary[]
  igConversations   IgConversation[]
  quickReplies      QuickReply[]
  igAutoReplies     IgAutoReply[]
  waConversations   WaConversation[]
  kycSubmissions    KycSubmission[]
  foreignAccounts   ForeignAccount[]
  // Virtual field only — no column is added to Business. The foreign key lives
  // on StaffTransferRequest.
  staffTransferRequests StaffTransferRequest[]

  @@index([userId])
  @@index([virtualAccountRef])
  @@index([kycBvnHash])
  @@index([kycCacHash])
}

// Saved transfer recipients — powers the "Recents" chips on Send Money so a
// repeat transfer starts from one tap instead of bank-search + 10 digits.
// Upserted on every successful outbound transfer.
model Beneficiary {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountNumber String
  bankCode      String
  bankName      String?
  accountName   String?
  timesUsed     Int      @default(1)
  lastUsedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([businessId, accountNumber, bankCode])
  @@index([businessId, lastUsedAt])
}

model BusinessOfficer {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role              String // "DIRECTOR" | "OWNER"
  firstName         String
  lastName          String
  middleName        String?
  bvn               String // encrypted via utils/crypto.js — re-used as the ID value field; idType disambiguates
  // HMAC-SHA-256 fingerprint of the encrypted bvn above. Searchable, irreversible.
  // Used for officer-level BVN dedup ("this person is already a director of
  // another KashBook business"). See server/src/utils/crypto.js hmacValue().
  bvnHash           String?  @db.VarChar(64)
  idType            String   @default("BVN") // "BVN" | "GhanaCard" | "KE_NID" | "SA_ID" | "EG_NID" | "UG_NIN"
  dateOfBirth       DateTime
  gender            String // "Male" | "Female"
  email             String?
  phoneNumber       String?
  nationality       String   @default("NG")
  title             String   @default("President")
  percentageOwned   Float    @default(0)
  addressLine1      String?
  addressLine2      String?
  addressCity       String?
  addressState      String?
  addressPostalCode String?
  addressCountry    String   @default("NG")
  createdAt         DateTime @default(now())

  @@index([businessId])
  @@index([bvnHash])
}

// ─────────────────────────────────────────────────────────────────────────────
// KYC pre-Anchor validation models. See server/src/utils/kycCheck.js.
//
// KycCheckAttempt   — append-only audit + rate-limit ledger. One row per
//                     attempted check of any type (bvn / cac / address / …).
// KycCheckCache     — successful Phase C / D responses, 24h TTL enforced in
//                     code via a daily purge cron. No plaintext PII; the
//                     result JSON is the provider's normalised response.
// ─────────────────────────────────────────────────────────────────────────────
model KycCheckAttempt {
  id           String   @id @default(cuid())
  userId       String
  checkType    String // "bvn" | "cac" | "address" | future: "nin" | …
  // SHA-256/HMAC hash of the checked value. For "address" it's a hash of the
  // normalised line1+city+state — lets us dedupe geocoding requests.
  valueHash    String   @db.VarChar(64)
  result       String // see kycCheck.js for the full enum
  provider     String? // "dojah" | "google" | null for cheap-layer rejects
  cached       Boolean  @default(false)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([checkType, valueHash, createdAt])
}

model KycCheckCache {
  // Composite key: checkType + valueHash. Composite primary key so we don't
  // accidentally collide hashes across check types.
  checkType String
  valueHash String   @db.VarChar(64)
  provider  String
  // Provider-specific normalised result. BVN: { firstName, lastName,
  // dateOfBirth, gender, phone? }. CAC: { businessName, registrationNumber,
  // status, directors[] }. Address: { lat, lng, formattedAddress, components }.
  result    Json
  cachedAt  DateTime @default(now())

  @@id([checkType, valueHash])
  @@index([cachedAt])
}

// Admin approval gate for account-opening (KYC/KYB). A user's virtual-account
// request is parked here as PENDING; nothing reaches Anchor until an admin
// approves. On approve the server replays the stored payload → Anchor. On
// decline the user sees the reason and may fix + resubmit.
// See server/src/services/virtualAccountProvisioning.js + routes/admin.js.
model KycSubmission {
  id            String              @id @default(cuid())
  businessId    String
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        KycSubmissionStatus @default(PENDING)
  businessType  String? // "individual" | "sole_proprietorship" | "limited_company"
  businessKyb   Boolean             @default(false)
  // AES-256-GCM encrypted JSON of the full request body (raw BVNs, owners, dob,
  // gender, address). Decrypted only at approval to call Anchor, then nulled
  // once provisioning starts so raw BVNs aren't retained beyond need.
  payload       String?             @db.Text
  // Non-sensitive summary the admin list renders (business name, type, masked
  // BVN, CAC, industry, owner names + %). Never holds a raw BVN.
  summary       Json?
  declineReason String?
  processError  String?
  reviewedById  String?
  reviewedAt    DateTime?
  processedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([businessId])
  @@index([userId])
}

// Foreign-currency (USD/EUR/GBP) receive account issued by Fincra. Async +
// consent-gated: created "pending", details land via the virtualaccount.issued
// webhook. One per (business, currency). Coexists with the local NUBAN.
model ForeignAccount {
  id              String    @id @default(uuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  currency        String // USD | EUR | GBP
  accountType     String    @default("individual") // individual | corporate
  status          String    @default("pending") // pending | approved | issued | declined
  fincraRequestId String?
  fincraAccountId String?
  accountNumber   String?
  accountName     String?
  bankName        String?
  // Wire details. Fincra's key is `bankSwiftCode` (individual, under otherInfo)
  // or a flat `swiftCode` (corporate). There is no "routing" key: the ACH
  // routing number is the top-level `bankCode`, and `addressableIn` names the
  // rail those details belong to (ACH | SWIFT | FEDWIRE | SEPA | FPS…).
  swift           String?
  routing         String? // = accountInformation.bankCode (ACH routing number)
  iban            String?
  sortCode        String? // GBP (FPS/CHAPS)
  bankAddress     String?
  addressableIn   String?
  memo            String? // reference the payer MUST include; differs per rail
  // Per-rail records, each with its own swift/memo/bankAddress. Stored whole:
  // flattening lets one rail's memo be displayed beside another rail's SWIFT,
  // which gets the wire rejected or misrouted.
  alternateAccountDetails Json?
  consentUrl      String?
  consentExpiresAt DateTime? // corporate FCY only; request expires if unused
  declineReason   String?
  inflowThisMonth Float     @default(0) // enforces the 10k USD/mo inflow cap
  inflowMonth     String? // "YYYY-MM" the counter applies to
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([businessId, currency])
  @@index([fincraRequestId])
  @@index([accountNumber])
}

model CustomCategory {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  label      String
  value      String
  icon       String   @default("pricetag-outline")
}

model Customer {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  businessId      String?
  business        Business? @relation(fields: [businessId], references: [id])
  name            String
  phone           String?
  totalOwed       Float     @default(0)
  reminderEnabled Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  debts             Debt[]
  sales             Sales[]
  transactions      Transaction[]
  invoices          Invoice[]
  igConversations   IgConversation[]
  waConversations   WaConversation[]
  recurringInvoices RecurringInvoice[]

  @@unique([userId, phone])
  @@index([userId, businessId])
  @@index([businessId, updatedAt])
}

model Debt {
  id         String        @id @default(uuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Float
  paidAmount Float         @default(0)
  paid       Boolean       @default(false)
  note       String        @default("")
  date       DateTime      @default(now())
  payments   DebtPayment[]

  @@index([customerId, paid])
}

model DebtPayment {
  id     String   @id @default(uuid())
  debtId String
  debt   Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount Float
  note   String   @default("")
  date   DateTime @default(now())
  // The bank credit that created this payment, when it came from matching an
  // incoming transfer to the customer's debt; null for manually recorded
  // payments. This is what lets UNMATCH reverse exactly the payments one credit
  // created and nothing else — without it, unmatching had to either leave the
  // money applied (the old bug) or guess by note text. Deliberately a bare
  // scalar, no @relation: a Transaction can be deleted with its business while
  // the payment history survives, and an FK would forbid that.
  transactionId String?

  @@index([transactionId])
}

model Payable {
  id           String           @id @default(uuid())
  businessId   String
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creditorName String
  category     String           @default("other")
  amount       Float
  paidAmount   Float            @default(0)
  dueDate      DateTime?
  note         String?
  date         DateTime         @default(now())
  paid         Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  payments     PayablePayment[]

  @@index([businessId, paid])
}

model PayablePayment {
  id        String   @id @default(uuid())
  payableId String
  payable   Payable  @relation(fields: [payableId], references: [id], onDelete: Cascade)
  amount    Float
  note      String?
  date      DateTime @default(now())
}

model BusinessDebt {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId      String?
  business        Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  name            String
  type            String    @default("other")
  originalAmount  Float
  remainingAmount Float
  dueDate         DateTime?
  note            String?
  status          String    @default("unpaid")
  reminderEnabled Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, businessId])
  @@index([userId, status])
  @@index([businessId, updatedAt])
}

model Sales {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId           String?
  customer             Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  businessId           String?
  business             Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  amount               Float
  currency             String    @default("NGN")
  paymentMethod        String    @default("cash")
  isCredit             Boolean   @default(false)
  notes                String?
  channel              String? // sales channel: instagram | whatsapp | walk-in | online | other
  matchedTransactionId String?
  recordedBy           String?
  recordedByName       String?
  date                 DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, businessId])
  @@index([businessId, date])
  @@index([businessId, updatedAt])
  @@index([businessId, channel])
}

model Expense {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  category      String    @default("other")
  amount        Float
  currency      String    @default("NGN")
  paymentMethod String    @default("cash")
  date          DateTime  @default(now())
  notes         String?
  // The outbound bank transfer this expense records, when it was created from
  // one ("tap a transfer you sent → record it as an expense"). Mirrors
  // Sales.matchedTransactionId: bare scalar, no FK, no unique — the code guards
  // one-expense-per-transfer under the business lock.
  matchedTransactionId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, businessId])
  @@index([businessId, date])
  @@index([businessId, updatedAt])
}

model Transaction {
  id                String    @id @default(uuid())
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type              String
  amount            Float
  description       String?
  category          String?
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  date              DateTime
  paymentMethod     String    @default("cash")
  matchedSaleId     String?
  matchedCustomerId String?
  // Expense mirror of matchedSaleId, for OUTBOUND transfers: the Expense row
  // recorded from this debit. Expense aggregates exclude debits carrying this,
  // exactly as income aggregates exclude matched credits.
  matchedExpenseId  String?
  recordedBy        String?
  recordedByName    String?
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  source            String?
  channel           String? // sales channel: instagram | whatsapp | walk-in | online | other
  // Deterministic idempotency key for Anchor-sourced money movement (transfers,
  // bills, inbound credits). The @@unique below makes "record this once" atomic:
  // a duplicate insert fails with P2002 instead of double-spending/double-crediting.
  // Null for manual/offline transactions (Postgres allows many nulls).
  reference         String?
  // Immutable provider-side identifier for this money movement (Anchor payment
  // id, transaction id or transfer id). `reference` is our own idempotency key
  // and gets re-keyed when a webhook repairs a reconcile-booked row; this one
  // records what the PROVIDER called it, so a row can always be traced back to
  // the source event without parsing the description.
  providerTxnId     String?
  currency          String    @default("NGN") // base currency at time of record; per-business default
  flagSeverity      String? // null | "low" | "medium" | "high"
  complianceStatus  String    @default("clean") // "clean" | "flagged" | "held" | "cleared"
  // Outbound-transfer fee charged to the user (₦51/₦101 pass-through + margin).
  // `amount` stays the transfer amount so income/expense reports are truthful;
  // the fee is its own field. Zero for everything that isn't an external transfer.
  fee               Float     @default(0)
  feeBreakdown      Json? // { nip, stampDuty, platform }
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([businessId, reference])
  @@index([businessId, providerTxnId])
  @@index([businessId, date])
  @@index([userId])
  @@index([businessId, updatedAt])
  @@index([complianceStatus, flagSeverity])
  @@index([businessId, channel])
}

// Idempotency ledger for inbound Anchor webhooks. We insert the provider event
// id BEFORE acting on it; a duplicate delivery hits the @unique and is skipped,
// so a credit/debit is processed exactly once regardless of re-delivery.
model ProcessedWebhook {
  id         String   @id @default(uuid())
  eventId    String   @unique
  type       String?
  receivedAt DateTime @default(now())
}

// ── Instagram DM cache ───────────────────────────────────────────────────────
// Meta stays the source of truth for messages; we keep a thin local cache so the
// in-app inbox renders fast and unread state survives a relaunch. Populated by
// the webhook (inbound) and by our own send calls (outbound). One conversation
// per (business, IG-scoped customer id) — webhook message events give us the
// participant IGSID but not always a thread id, so the IGSID is the stable key
// and igThreadId is filled lazily from the Conversations API.
model IgConversation {
  id                     String      @id @default(uuid())
  businessId             String
  business               Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  participantIgId        String // the customer's IG-scoped user id (IGSID) — stable key
  igThreadId             String? // Meta conversation id, when known
  participantUsername    String?
  // Stable link to the bookkeeping Customer (set on first record-sale / invoice).
  // Used instead of matching by display name, which can collide.
  customerId             String?
  customer               Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lastMessageAt          DateTime    @default(now())
  // Last time the CUSTOMER messaged us — gates the 24h standard / 7d HUMAN_AGENT
  // send window (Meta blocks replies outside it). Distinct from lastMessageAt,
  // which also moves on our own outbound replies. See docs/INSTAGRAM_API_SPEC.md §4.
  lastInboundAt          DateTime?
  // Auto payment confirmation: when the merchant sends a "Request ₦X" in this
  // thread we store the expected amount + time. An inbound NUBAN credit that
  // matches it (within 48h, exactly one candidate) auto-replies "payment
  // received", clears these, and stamps lastPaymentConfirmedAt. See
  // server/src/utils/igPaymentMatch.js.
  expectedAmount         Float?
  expectedSince          DateTime?
  lastPaymentConfirmedAt DateTime?
  unread                 Boolean     @default(false)
  createdAt              DateTime    @default(now())
  messages               IgMessage[]

  @@unique([businessId, participantIgId])
  @@index([businessId, lastMessageAt])
  // Supports the auto-payment matcher's per-business "armed conversations" query
  // (WHERE businessId=? AND expectedAmount IS NOT NULL …), run on every credit.
  @@index([businessId, expectedAmount])
}

// Automated IG DM replies. "greeting" fires once on a conversation's first
// inbound message; "keyword" fires when an inbound message contains the keyword.
model IgAutoReply {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       String // "greeting" | "keyword" | "comment" | "away"
  keyword    String? // for kind="keyword"/"comment" (matched case-insensitively; null comment = any)
  text       String   @db.VarChar(900)
  fromHour   Int? // for kind="away": window start hour 0-23 (Africa/Lagos)
  toHour     Int? // for kind="away": window end hour 0-23
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([businessId])
}

// Saved canned replies a merchant can insert into an IG DM with one tap.
model QuickReply {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  text       String   @db.VarChar(900) // DB-enforced cap (route also validates ≤900)
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model IgMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   IgConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  igMessageId    String         @unique // Meta message id (mid) — dedups redelivered webhooks
  direction      String // "in" (from customer) | "out" (from merchant)
  text           String?
  attachmentUrl  String? // inbound image/media URL (temporary, signed by Meta)
  sentAt         DateTime       @default(now())

  @@index([conversationId, sentAt])
}

// ── WhatsApp DM cache (Cloud API) ────────────────────────────────────────────
// Mirrors IgConversation/IgMessage. One conversation per (business, customer
// wa_id/phone). Populated by the webhook (inbound) and our own sends (outbound).
// Carries the same auto-payment-confirm fields and stable customer link the IG
// models gained through review — included from day one here.
model WaConversation {
  id                     String      @id @default(uuid())
  businessId             String
  business               Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  participantPhone       String // the customer's wa_id (E.164 digits) — stable key
  participantName        String? // WhatsApp profile name
  customerId             String?
  customer               Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lastMessageAt          DateTime    @default(now())
  lastInboundAt          DateTime? // gates the 24h free-form send window
  expectedAmount         Float?
  expectedSince          DateTime?
  lastPaymentConfirmedAt DateTime?
  unread                 Boolean     @default(false)
  createdAt              DateTime    @default(now())
  messages               WaMessage[]

  @@unique([businessId, participantPhone])
  @@index([businessId, lastMessageAt])
  @@index([businessId, expectedAmount])
  @@index([customerId])
}

model WaMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  waMessageId    String         @unique // wamid — dedups redelivered webhooks
  direction      String // "in" | "out"
  text           String?
  attachmentUrl  String? // re-hosted media URL (media download needs auth — later batch)
  sentAt         DateTime       @default(now())

  @@index([conversationId, sentAt])
}

model InventoryItem {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  unit          String    @default("piece")
  price         Float
  cost          Float?
  quantity      Int       @default(0)
  lowStockAlert Int       @default(5)
  category      String?
  sku           String?
  barcode       String?
  image         String?
  lastRestocked DateTime?
  createdBy     String?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, businessId])
  @@index([businessId, updatedAt])
}

// Recurring invoices — PREMIUM. A rule auto-creates a SENT invoice (+ share
// link) for a customer on a schedule (same frequency strings + nextDue/active
// discipline as RecurringExpense; processed by utils/recurringInvoiceRunner.js).
model RecurringInvoice {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  description   String // the invoice line item, e.g. "Weekly supply"
  amount        Float
  frequency     String    @default("monthly") // daily | weekly | monthly | yearly | custom_N
  dueInDays     Int? // dueDate = issueDate + N days; null = no due date
  nextDue       DateTime
  active        Boolean   @default(true)
  lastRunAt     DateTime?
  lastInvoiceId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, active])
  @@index([nextDue, active])
}

model RecurringExpense {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId          String?
  business            Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  category            String    @default("other")
  amount              Float
  paymentMethod       String    @default("cash")
  notes               String?
  frequency           String    @default("monthly")
  nextDue             DateTime
  active              Boolean   @default(true)
  // ── Auto-debit (off by default; backwards-compatible) ──────────────────
  autoSend            Boolean   @default(false)
  authorizedAt        DateTime?
  payeeAccountNumber  String?
  payeeBankCode       String?
  payeeBankName       String?
  payeeAccountName    String?
  lastAutoSendAt      DateTime?
  lastAutoSendStatus  String? // "ok" | "insufficient_balance" | "blocked_aml" | "anchor_error" | "above_cap" | "skipped_paused"
  lastAutoSendRef     String?
  consecutiveFailures Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, active])
  @@index([nextDue, active])
  @@index([active, autoSend])
}

model OtpCode {
  id         String   @id @default(uuid())
  identifier String
  type       String
  // HMAC-SHA256(identifier:code) keyed with a server secret — never plaintext.
  code       String
  expiresAt  DateTime
  used       Boolean  @default(false)
  // Failed verification counter. The send-side throttle never limited GUESSING,
  // so a 6-digit code was brute-forceable given enough source IPs. The code is
  // burned at MAX_OTP_ATTEMPTS misses (utils/otp.js).
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([identifier, type])
}

model Reminder {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  targetId      String?
  type          String    @default("debt")
  amount        Float     @default(0)
  recipientName String    @default("")
  phone         String?
  message       String?   @db.Text
  channel       String    @default("sms")
  status        String    @default("pending")
  scheduledFor  DateTime
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, scheduledFor])
  @@index([userId])
}

model Suggestion {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("feature")
  content   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id             String            @id @default(uuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId         String
  invoiceNumber  String
  type           String            @default("invoice") // "invoice" | "quote" (quotes convert to invoices)
  status         InvoiceStatus     @default(DRAFT)
  issueDate      String
  dueDate        String?
  currency       String            @default("NGN")
  subtotal       Float             @default(0)
  taxRate        Float             @default(0)
  taxAmount      Float             @default(0)
  discountType   String?
  discountValue  Float             @default(0)
  discountAmount Float             @default(0)
  total          Float             @default(0)
  amountPaid     Float             @default(0)
  notes          String?
  terms          String?
  template       String            @default("classic")
  items          InvoiceItem[]
  payments       InvoicePayment[]
  shareLink      InvoiceShareLink?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([businessId, userId])
  @@index([businessId, status])
  @@index([businessId, updatedAt])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  quantity    Float   @default(1)
  rate        Float   @default(0)
  amount      Float   @default(0)
}

model InvoicePayment {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("cash")
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model InvoiceShareLink {
  id        String   @id @default(cuid())
  invoiceId String   @unique
  token     String   @unique
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([token])
}

enum Plan {
  FREE
  PREMIUM
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  OWNER
  STAFF
}

enum KycSubmissionStatus {
  PENDING // awaiting admin review
  APPROVED // admin approved; Anchor provisioning ran
  DECLINED // admin declined (declineReason set); user may resubmit
  FAILED // approved but validation/Anchor failed; admin can retry
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
}

// Append-only audit log — used for every state-changing or security-relevant
// action. Reviewed by admins via the compliance dashboard.
model AuditLog {
  id           String   @id @default(cuid())
  actorType    String // "user" | "admin" | "system"
  actorId      String?
  action       String
  resourceType String?
  resourceId   String?
  ip           String?
  userAgent    String?
  metadata     Json?
  severity     String   @default("info") // "info" | "warn" | "alert"
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([severity, createdAt])
  @@index([createdAt])
  @@index([action, createdAt])
}

// Open-review queue for the compliance team. Rules engine writes here; admins
// transition status to cleared/escalated/frozen.
// Per-staff capability grants, managed by the business owner.
//
// THE ROW'S EXISTENCE IS THE GRANT. No row means no permissions, so on the day
// this ships every existing staff member has exactly zero new access and there
// is no NULL-column path that could read as "allowed". Every flag additionally
// defaults false, so even a half-written row cannot grant anything.
//
// A separate table rather than columns on User, deliberately:
//   * it is the most additive change possible on a database shared with another
//     deployed app — a brand-new table it has never heard of, no ALTER TABLE
//     against anything it reads;
//   * User is the hottest row in the system (atomic PIN-attempt increments,
//     tokenVersion bumps on revoke), and permission writes should not contend
//     with security-critical ones;
//   * a JSON blob would be worse still: a PATCH that omits a key silently
//     revokes it, and any defaulting written as `!== false` would fail OPEN on
//     the money permission.
model StaffPermission {
  id         String @id @default(uuid())
  userId     String @unique // the STAFF User.id
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerId String // denormalised owner id — the tenant key, and cross-checked
  //                   against User.employerId at read time so a stale grant from
  //                   a previous employer can never be honoured.

  canViewBalance    Boolean @default(false) // the account number AND the balance
  canTransfer       Boolean @default(false) // send money, subject to dailyTransferCap
  canViewReports    Boolean @default(false) // reports and insights
  canManagePayables Boolean @default(false) // add suppliers, record payments

  // Autonomous spend ceiling over a ROLLING 24 hours (not a calendar day — a
  // midnight reset would let a staff member spend the cap twice inside two
  // minutes; see utils/staffTransferCap.js). null or 0 means every transfer
  // needs the owner's approval. There is deliberately NO "unlimited" value:
  // uncapped staff spending is not a state this system should be able to express.
  dailyTransferCap Float?

  grantedById String // the owner who last changed this, for the audit trail
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employerId])
}

// A staff transfer that exceeded the staff member's daily cap and is waiting on
// the owner. This is deliberately NOT a Transaction row with complianceStatus
// "held": computeRawLedger (utils/ledgerBalance.js) sums Transaction filtered on
// businessId/paymentMethod/currency/source/type/category and does NOT filter on
// complianceStatus, so a pending transfer parked there would immediately reduce
// the spendable balance for money that never left, and could trip the
// pooled-wallet coverage alarm in alerts.js. Money that has not moved does not
// belong in the ledger.
model StaffTransferRequest {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedById String // the STAFF User.id
  ownerId       String // denormalised, so the owner's pending list is one indexed read

  // Frozen copy of the transfer as requested. Deliberately a snapshot, not a
  // reference: what the owner approves must be exactly what was asked for, even
  // if the beneficiary record is edited in between.
  accountNumber String
  bankCode      String
  bankName      String?
  // Resolved by NAME ENQUIRY at hold time, not copied from the staff member's
  // request body. If the enquiry failed, this is their supplied name and
  // nameVerified is false, which the owner's approval sheet must surface —
  // approving a name nobody checked is the whole risk this queue exists to
  // manage.
  accountName   String?
  nameVerified  Boolean @default(false)
  amount        Float
  narration     String?
  currency      String  @default("NGN")

  // pending → approved → executed, or pending → rejected | cancelled | expired,
  // or approved → failed (the provider refused after the owner said yes).
  // Terminal states are never revisited. Claimed atomically with an updateMany
  // guarded on the previous status, so a double-tap cannot execute twice.
  status String @default("pending")
  reason String? // why it was held, or the rejection reason the staff member sees

  // Minted at request time and carried through to execution, so approving twice
  // hits the executor's existing-reference short-circuit rather than sending
  // twice. Unique across the table as a second line of defence.
  idempotencyKey String @unique

  // The cap this was measured against, kept for the audit trail: the owner may
  // change the cap after the fact and the record should still explain itself.
  capAtRequest   Float?
  spentAtRequest Float?

  decidedById           String? // the owner who approved or rejected
  decidedAt             DateTime?
  executedTransactionId String? // set on success; the daily-cap query excludes
  //                               these, because money the owner personally
  //                               approved was not unsupervised spend
  executedReference     String?
  failureReason         String?

  // Approvals go stale. A transfer the owner authorises days later, at a price
  // and for a reason they no longer hold in mind, is worse than one that lapsed
  // and had to be asked for again.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([businessId, status])
  @@index([requestedById, status])
  @@index([status, expiresAt])
}

model ComplianceFlag {
  id            String    @id @default(uuid())
  userId        String
  businessId    String?
  transactionId String?
  ruleCode      String
  severity      String // "low" | "medium" | "high"
  description   String
  metadata      Json
  status        String    @default("open") // "open" | "cleared" | "escalated" | "frozen"
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewerNote  String?
  createdAt     DateTime  @default(now())

  @@index([status, severity, createdAt])
  @@index([userId])
  @@index([transactionId])
}

// ── Observability ─────────────────────────────────────────────────────────────
// Health/analytics history snapshots, cron heartbeats and alert-cooldown state.
// Exception tracking is handled by Sentry (see server/src/instrument.js), not in
// the DB. See server/src/utils/{metrics,healthCheck,alerts}.js.

model MetricSnapshot {
  id      String   @id @default(uuid())
  kind    String // "health" | "analytics"
  takenAt DateTime @default(now())
  data    Json

  @@index([kind, takenAt])
}

model CronHeartbeat {
  name       String   @id // cron identifier
  lastRunAt  DateTime
  lastStatus String   @default("ok") // "ok" | "error"
  lastError  String?
}

model AlertState {
  key         String   @id // alert rule key
  lastFiredAt DateTime
  lastValue   String?
}
