generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String      @id @default(uuid())
  firstName                 String
  // Legal middle name as printed on the ID. Optional: many Nigerian IDs have
  // none, and Anchor/Fincra KYC match on first + last.
  middleName                String?
  lastName                  String
  businessName              String
  phone                     String?     @unique
  email                     String?     @unique
  password                  String?
  plan                      Plan        @default(FREE)
  role                      Role        @default(USER)
  accountType               AccountType @default(OWNER)
  employerId                String?
  profileImage              String?     @db.Text
  avatarUrl                 String?
  expoPushToken             String?
  country                   String      @default("NG") // ISO 3166-1 alpha-2 — drives currency, language, calling code, KYC, AML
  language                  String      @default("en")
  currency                  String      @default("NGN") // derived from country at write-time
  notificationsEnabled      Boolean     @default(true)
  biometricEnabled          Boolean     @default(false)
  autoDebitEnabled          Boolean     @default(true) // global kill-switch for all recurring auto-debits
  transactionPin            String?
  transactionPinFailedCount Int         @default(0)
  transactionPinLockedUntil DateTime?
  failedLoginAttempts       Int         @default(0)
  lockedUntil               DateTime?
  // Bumped on password change / logout-all; JWTs carry this value and are
  // rejected by authMiddleware once it no longer matches (session revocation).
  tokenVersion              Int         @default(0)
  dateOfBirth               DateTime?
  gender                    String?
  // The code this user typed at signup, i.e. who referred THEM. Stored raw and
  // unvalidated for now; nothing consumes it yet.
  referredByCode            String?
  // Consent records. NDPA treats marketing consent as something that must be
  // evidenced, and terms acceptance is the legal basis for the account, so both
  // are stored rather than assumed from the fact that signup completed.
  marketingOptIn            Boolean   @default(false)
  termsAcceptedAt           DateTime?
  anchorCustomerId          String?     @unique
  fincraCustomerRef         String?
  kycStatus                 String      @default("unverified")
  accountStatus             String      @default("active") // "active" | "restricted" | "frozen" | "closed"
  complianceFreezeReason    String?
  complianceFrozenAt        DateTime?
  complianceFrozenBy        String?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  businesses        Business[]
  customers         Customer[]
  transactions      Transaction[]
  sales             Sales[]
  expenses          Expense[]
  businessDebts     BusinessDebt[]
  suggestions       Suggestion[]
  reminders         Reminder[]
  inventoryItems    InventoryItem[]
  itemGroups        ItemGroup[]
  notifications     AppNotification[]
  recurringExpenses RecurringExpense[]
  recurringInvoices RecurringInvoice[]
  kycSubmissions    KycSubmission[]
  // Back-reference only — the FK lives on StaffPermission, so this emits no SQL
  // against User. `employerId` above stays a bare String? on purpose: adding a
  // real FK to it would mean ALTER TABLE "User" on a database shared with
  // another deployed app, and would fail outright on any orphaned row.
  staffPermission   StaffPermission?

  // DECLARED so schema and database agree. The staff-permissions migration
  // creates this index (employerId had been queried unindexed since staff were
  // introduced), but it was never written here — and Prisma treats the schema as
  // the truth. The next `migrate diff` against production would therefore have
  // emitted a DROP INDEX for it, quietly undoing the fix on a database SHARED
  // with another live app. A missing @@index is not cosmetic drift; it is a
  // pending destructive migration.
  @@index([employerId])
}

model AppNotification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

model Business {
  id                         String    @id @default(uuid())
  userId                     String
  user                       User      @relation(fields: [userId], references: [id])
  name                       String
  emoji                      String    @default("🛍️")
  color                      String    @default("#6C3FC5")
  logoUrl                    String?
  receiptFooter              String?
  invoiceTemplate            String    @default("classic")
  bankName                   String?
  bankAccountNumber          String?
  bankAccountName            String?
  usePaymentOverride         Boolean   @default(false)
  riskCategory               String    @default("standard") // "standard" | "elevated" | "high"
  accountStatus              String    @default("active") // "active" | "restricted" | "frozen" | "closed"
  country                    String    @default("NG") // immutable after creation; drives currency + KYC + AML + banking
  baseCurrency               String    @default("NGN") // locked to country; dashboard / cash totals / AML thresholds read this
  kycId                      String? // generic primary KYC identifier (encrypted)
  kycIdType                  String    @default("BVN") // "BVN" | "GhanaCard" | "KE_NID" | "SA_ID" | "EG_NID" | "UG_NIN"
  invoiceCounter             Int       @default(0)
  invoicePrefix              String? // NULL = "INV-"; "" = plain numbers. Quotes keep "QTE-".
  invoiceNumberMode          String? // NULL/"auto" = server numbers invoices; "manual" = the app asks for one
  creditNoteCounter          Int       @default(0) // credit notes have their own run of numbers
  creditNotePrefix           String? // NULL = "CN-"; "" = plain numbers
  creditNoteNumberMode       String? // NULL/"auto" or "manual", as for invoices
  taxId                     String? // display-only Tax ID / RC number for documents (P&L, invoices)
  virtualAccountRef          String?
  virtualAccountId           String?
  // @unique: one NUBAN belongs to exactly one business. Without this, the
  // sync-anchor-account hatch could clone one KYC-verified account onto many
  // businesses, each then resolving to its OWN full AML tier limits on the same
  // real account (an N× multiplication of the regulator-facing cap).
  virtualAccountNumber       String?   @unique
  virtualAccountBank         String?
  virtualAccountName         String?
  anchorAccountId            String?   @unique
  // Provider-neutral banking identity (Fincra swap). New code gates "has
  // banking" on providerAccountId instead of anchorAccountId.
  providerAccountId          String?   @unique
  paymentProviderRef         String?
  localAccountStatus         String?   @default("none") // none | pending | issued
  bankAccountType            String    @default("SAVINGS")
  kycBvn                     String?
  kycCacNumber               String?
  // HMAC-SHA-256 fingerprints of the encrypted identifiers above. Searchable,
  // irreversible — used for dedup ("has anyone else registered this BVN/CAC")
  // and for the KycCheckCache lookup. See server/src/utils/crypto.js hmacValue().
  kycBvnHash                 String?   @db.VarChar(64)
  kycCacHash                 String?   @db.VarChar(64)
  kycBusinessType            String?   @default("sole_proprietor")
  cacCertificateUrl          String?
  description                String?
  industry                   String?
  registrationType           String?
  dateOfRegistration         DateTime?
  dateOfIncorporation        DateTime?
  addressState               String?
  addressLine1               String?
  addressLine2               String?
  addressCity                String?
  addressPostalCode          String?
  directorAddressSame        Boolean   @default(true)
  directorAddressLine1       String?
  directorAddressState       String?
  directorAddressCity        String?
  // ── Instagram (per-business OAuth connection — Path A: Instagram Login) ───
  // The merchant connects their IG Professional account (Instagram Login, no
  // Facebook Page) so they can read/reply to DMs and send their NUBAN payment
  // details from inside KashBook. The token is a long-lived (~60d) IG User
  // token, refreshed by a cron, stored ENCRYPTED at rest (enc:v1:… via
  // utils/crypto.encrypt). The id/username are plaintext. Tokens are
  // per-Business (one user may own several businesses / IG accounts).
  // See docs/INSTAGRAM_API_SPEC.md for the verified Meta contracts.
  instagramAccessToken       String? // encrypt()-ed long-lived token — never returned to the client
  // @unique: one IG account ↔ one business. Webhook routing is by this id, so a
  // duplicate would make routing ambiguous. Nullable-unique → Postgres allows
  // many NULLs (un-connected businesses) but rejects a second claim of the same
  // id, closing the connect-callback TOCTOU race (caught as P2002).
  instagramBusinessAccountId String?   @unique // the merchant's IG account id (IGID)
  instagramUsername          String? // @handle, for display
  igTokenExpiresAt           DateTime?
  igConnectionStatus         String?   @default("disconnected") // "disconnected" | "connected" | "expired" | "error"
  igWebhookSubscribed        Boolean   @default(false) // did me/subscribed_apps succeed? if false, inbound DMs won't arrive
  // ── WhatsApp Business (Cloud API — Embedded Signup) ───────────────────────
  // Per-merchant WABA connection mirroring the Instagram block above. The token
  // is a business-scoped token (NO expiry — no refresh cron), stored encrypted.
  // waPhoneNumberId is the webhook routing key. See docs/WHATSAPP_API_SPEC.md.
  waAccessToken              String? // encrypt()-ed business token — never returned to clients
  wabaId                     String? // WhatsApp Business Account id
  waPhoneNumberId            String?   @unique // Cloud API phone-number id (routing key)
  waPhoneNumber              String? // display number, e.g. +23480…
  waConnectionStatus         String?   @default("disconnected") // "disconnected" | "connected" | "error"
  waWebhookSubscribed        Boolean   @default(false)
  // VAT summary settings. Off by default (most micro-traders aren't VAT-
  // registered). vatRate null → country default. vatInclusive: are recorded
  // amounts treated as VAT-inclusive (true, NG default) or exclusive.
  vatEnabled                 Boolean   @default(false)
  vatRate                    Float?
  vatInclusive               Boolean   @default(true)
  // Chart of accounts (2026-10-11): the day the books start (opening balances
  // are as at the start of it) and the month the financial year starts.
  openingBalanceDate         String?
  fiscalYearStartMonth       Int       @default(1)
  // Categories of the accounts the owner deleted (or made another kind of
  // account): nothing makes an account for one again (release 1.1, 2026-10-13).
  retiredCategorySlugs       String[]  @default([])
  // Release 2 (2026-10-13): the last manual journal number given (MJ-00001),
  // and the lock date, a Lagos "YYYY-MM-DD" on or before which nothing dated
  // may be added, changed or removed (utils/booksLock.js; a CHECK keeps it a
  // plain day).
  journalCounter             Int       @default(0)
  booksLockDate              String?
  // Release 3 (2026-10-13): what the business sells, goods | services | both
  // (CHECK in the migration); null: not asked yet, shown as both.
  sells                      String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  transactions      Transaction[]
  sales             Sales[]
  expenses          Expense[]
  businessDebts     BusinessDebt[]
  customCategories  CustomCategory[]
  inventoryItems    InventoryItem[]
  customers         Customer[]
  reminders         Reminder[]
  payables          Payable[]
  invoices          Invoice[]
  creditApplications CreditApplication[]
  recurringExpenses RecurringExpense[]
  recurringInvoices RecurringInvoice[]
  officers          BusinessOfficer[]
  beneficiaries     Beneficiary[]
  igConversations   IgConversation[]
  quickReplies      QuickReply[]
  igAutoReplies     IgAutoReply[]
  waConversations   WaConversation[]
  kycSubmissions    KycSubmission[]
  foreignAccounts   ForeignAccount[]
  fcyConversions    FcyConversion[]
  // Virtual field only — no column is added to Business. The foreign key lives
  // on StaffTransferRequest.
  staffTransferRequests StaffTransferRequest[]
  salarySchedules       SalarySchedule[]
  salaryPayments        SalaryPayment[]
  savingsPots           SavingsPot[]
  savingsMovements      SavingsMovement[]
  ledgerAccounts        LedgerAccount[]
  openingBalances       OpeningBalance[]
  manualJournals        ManualJournal[]
  saleItems             SaleItem[]
  stockMovements        StockMovement[]
  itemGroups            ItemGroup[]

  @@index([userId])
  @@index([virtualAccountRef])
  @@index([kycBvnHash])
  @@index([kycCacHash])
}

// Saved transfer recipients — powers the "Recents" chips on Send Money so a
// repeat transfer starts from one tap instead of bank-search + 10 digits.
// Upserted on every successful outbound transfer.
model Beneficiary {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountNumber String
  bankCode      String
  bankName      String?
  accountName   String?
  timesUsed     Int      @default(1)
  lastUsedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([businessId, accountNumber, bankCode])
  @@index([businessId, lastUsedAt])
}

model BusinessOfficer {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role              String // "DIRECTOR" | "OWNER"
  firstName         String
  lastName          String
  middleName        String?
  bvn               String // encrypted via utils/crypto.js — re-used as the ID value field; idType disambiguates
  // HMAC-SHA-256 fingerprint of the encrypted bvn above. Searchable, irreversible.
  // Used for officer-level BVN dedup ("this person is already a director of
  // another KashBook business"). See server/src/utils/crypto.js hmacValue().
  bvnHash           String?  @db.VarChar(64)
  idType            String   @default("BVN") // "BVN" | "GhanaCard" | "KE_NID" | "SA_ID" | "EG_NID" | "UG_NIN"
  dateOfBirth       DateTime
  gender            String // "Male" | "Female"
  email             String?
  phoneNumber       String?
  nationality       String   @default("NG")
  title             String   @default("President")
  percentageOwned   Float    @default(0)
  addressLine1      String?
  addressLine2      String?
  addressCity       String?
  addressState      String?
  addressPostalCode String?
  addressCountry    String   @default("NG")
  createdAt         DateTime @default(now())

  @@index([businessId])
  @@index([bvnHash])
}

// ─────────────────────────────────────────────────────────────────────────────
// KYC pre-Anchor validation models. See server/src/utils/kycCheck.js.
//
// KycCheckAttempt   — append-only audit + rate-limit ledger. One row per
//                     attempted check of any type (bvn / cac / address / …).
// KycCheckCache     — successful Phase C / D responses, 24h TTL enforced in
//                     code via a daily purge cron. No plaintext PII; the
//                     result JSON is the provider's normalised response.
// ─────────────────────────────────────────────────────────────────────────────
model KycCheckAttempt {
  id           String   @id @default(cuid())
  userId       String
  checkType    String // "bvn" | "cac" | "address" | future: "nin" | …
  // SHA-256/HMAC hash of the checked value. For "address" it's a hash of the
  // normalised line1+city+state — lets us dedupe geocoding requests.
  valueHash    String   @db.VarChar(64)
  result       String // see kycCheck.js for the full enum
  provider     String? // "dojah" | "google" | null for cheap-layer rejects
  cached       Boolean  @default(false)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([checkType, valueHash, createdAt])
}

model KycCheckCache {
  // Composite key: checkType + valueHash. Composite primary key so we don't
  // accidentally collide hashes across check types.
  checkType String
  valueHash String   @db.VarChar(64)
  provider  String
  // Provider-specific normalised result. BVN: { firstName, lastName,
  // dateOfBirth, gender, phone? }. CAC: { businessName, registrationNumber,
  // status, directors[] }. Address: { lat, lng, formattedAddress, components }.
  result    Json
  cachedAt  DateTime @default(now())

  @@id([checkType, valueHash])
  @@index([cachedAt])
}

// Admin approval gate for account-opening (KYC/KYB). A user's virtual-account
// request is parked here as PENDING; nothing reaches Anchor until an admin
// approves. On approve the server replays the stored payload → Anchor. On
// decline the user sees the reason and may fix + resubmit.
// See server/src/services/virtualAccountProvisioning.js + routes/admin.js.
model KycSubmission {
  id            String              @id @default(cuid())
  businessId    String
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        KycSubmissionStatus @default(PENDING)
  businessType  String? // "individual" | "sole_proprietorship" | "limited_company"
  businessKyb   Boolean             @default(false)
  // AES-256-GCM encrypted JSON of the full request body (raw BVNs, owners, dob,
  // gender, address). Decrypted only at approval to call Anchor, then nulled
  // once provisioning starts so raw BVNs aren't retained beyond need.
  payload       String?             @db.Text
  // Non-sensitive summary the admin list renders (business name, type, masked
  // BVN, CAC, industry, owner names + %). Never holds a raw BVN.
  summary       Json?
  declineReason String?
  processError  String?
  reviewedById  String?
  reviewedAt    DateTime?
  processedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([businessId])
  @@index([userId])
}

// Foreign-currency (USD/EUR/GBP) receive account issued by Fincra. Async +
// consent-gated: created "pending", details land via the virtualaccount.issued
// webhook. One per (business, currency). Coexists with the local NUBAN.
model ForeignAccount {
  id              String    @id @default(uuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  currency        String // USD | EUR | GBP
  accountType     String    @default("individual") // individual | corporate
  status          String    @default("pending") // pending | approved | issued | declined
  fincraRequestId String?
  fincraAccountId String?
  accountNumber   String?
  accountName     String?
  bankName        String?
  // Wire details. Fincra's key is `bankSwiftCode` (individual, under otherInfo)
  // or a flat `swiftCode` (corporate). There is no "routing" key: the ACH
  // routing number is the top-level `bankCode`, and `addressableIn` names the
  // rail those details belong to (ACH | SWIFT | FEDWIRE | SEPA | FPS…).
  swift           String?
  routing         String? // = accountInformation.bankCode (ACH routing number)
  iban            String?
  sortCode        String? // GBP (FPS/CHAPS)
  bankAddress     String?
  addressableIn   String?
  memo            String? // reference the payer MUST include; differs per rail
  // Per-rail records, each with its own swift/memo/bankAddress. Stored whole:
  // flattening lets one rail's memo be displayed beside another rail's SWIFT,
  // which gets the wire rejected or misrouted.
  alternateAccountDetails Json?
  consentUrl      String?
  consentExpiresAt DateTime? // corporate FCY only; request expires if unused
  declineReason   String?
  inflowThisMonth Float     @default(0) // enforces the 10k USD/mo inflow cap
  inflowMonth     String? // "YYYY-MM" the counter applies to
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([businessId, currency])
  @@index([fincraRequestId])
  @@index([accountNumber])
}

// One euro → naira conversion attempt, quote through to the naira landing.
// Exists because the ledger alone cannot describe the failure that matters: the
// euros have left the merchant's balance (converted at Fincra) but the naira
// payout to their NUBAN failed. "converted" / "payout_failed" is money we owe
// until the payout succeeds; utils/fcyConversion.retryStuckConversions drives
// rows out of those states. Both references are unique so a retry can never pay
// twice. Money-path detail in utils/fcyConversion.js.
model FcyConversion {
  id                      String    @id @default(uuid())
  businessId              String
  business                Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId                  String?
  sourceCurrency          String
  destinationCurrency     String    @default("NGN")
  sourceAmount            Float     // debited from the merchant's FCY ledger balance
  fee                     Float     @default(0) // any source-side charge beyond sourceAmount
  rate                    Float
  grossDestinationAmount  Float     // what Fincra delivers to our naira wallet
  destinationAmount       Float     // what the merchant gets, after marginBps
  marginBps               Int       @default(0)
  // quoted | converting | converted | paying_out | paid | payout_failed | failed | needs_review
  status                  String    @default("quoted")
  quoteReference          String
  quoteExpiresAt          DateTime
  customerReference       String    @unique // kb_cv_…  (the conversion)
  conversionReference     String?
  payoutCustomerReference String    @unique // kb_cvp_… (the naira payout)
  payoutReference         String?
  // Snapshot of the destination, name-verified at quote time.
  payoutAccountNumber     String
  payoutBankCode          String
  payoutBankName          String?
  payoutAccountName       String?
  error                   String?
  convertedAt             DateTime?
  paidAt                  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([businessId, createdAt])
  @@index([status])
}

// ── Savings ──────────────────────────────────────────────────────────────────
// Pots ring-fenced in the merchant's own Anchor account. Money-path detail in
// utils/savings.js; the reserve maths in utils/savingsReserve.js.

// A pot. Nothing moves: `balance` is a reserve that every spend path subtracts
// from the bank balance before it lets money out.
model SavingsPot {
  id           String    @id @default(uuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId       String
  name         String
  targetAmount Float?
  status       String    @default("active") // active | closed
  balance      Float     @default(0)
  lockUntil    DateTime?
  lockMode     String?   // strict | flexible
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  movements    SavingsMovement[]

  @@index([businessId, status])
}

// Every movement of money into or out of a pot. `reference` is the client's
// idempotency key (kb_sv_… deposits, kb_svw_… withdrawals) and is unique, so a
// retried request answers with the row it already made. `fee` is the
// early-withdrawal charge on a flexible lock and `feeCollectedAt` is when it
// was swept to the fee account (claimed before the book transfer, so never twice).
model SavingsMovement {
  id             String     @id @default(uuid())
  potId          String
  pot            SavingsPot @relation(fields: [potId], references: [id], onDelete: Cascade)
  businessId     String
  business       Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String?
  type           String     // deposit | withdrawal
  amount         Float
  fee            Float      @default(0)
  status         String     @default("completed")
  reference      String     @unique
  feeCollectedAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([potId, createdAt])
  @@index([businessId, createdAt])
}

model CustomCategory {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  label      String
  value      String
  icon       String   @default("pricetag-outline")
}

model Customer {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  businessId      String?
  business        Business? @relation(fields: [businessId], references: [id])
  name            String // the display name (invoices, lists, reminders)
  phone           String? // the mobile number: WhatsApp, reminders, duplicate check
  totalOwed       Float     @default(0)
  reminderEnabled Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // The Add Contact form (2026-10-10). All optional; see utils/customerFields.js.
  customerType    String? // "business" | "individual"
  salutation      String?
  firstName       String?
  lastName        String?
  companyName     String?
  email           String?
  workPhone       String? // the form's "Phone"; `phone` is its "Mobile"
  website         String?
  taxId           String? // the customer's TIN, copied onto their invoices
  paymentTerms    String? // default terms for new invoices (never "custom")
  billingAddress  Json? // { attention, street1, street2, city, state, postalCode, country, phone }
  shippingAddress Json?
  contactPersons  Json? // [{ id, salutation, firstName, lastName, email, phone, designation }]
  notes           String? // private remarks, never printed
  inactiveAt      DateTime? // marked inactive (More menu); null = active

  debts             Debt[]
  sales             Sales[]
  expenses          Expense[]
  transactions      Transaction[]
  invoices          Invoice[]
  igConversations   IgConversation[]
  waConversations   WaConversation[]
  recurringInvoices RecurringInvoice[]

  @@unique([userId, phone])
  @@index([userId, businessId])
  @@index([businessId, updatedAt])
}

model Debt {
  id         String        @id @default(uuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Float
  paidAmount Float         @default(0)
  paid       Boolean       @default(false)
  note       String        @default("")
  date       DateTime      @default(now())
  payments   DebtPayment[]
  // The credit Sales row this debt was opened for ("sold on credit"), when it
  // came from Add Sale. Books rule: that sale counts when the customer pays,
  // through the DebtPayments, not on the sale date. Bare scalar like
  // DebtPayment.transactionId.
  saleId     String?

  @@index([customerId, paid])
  @@index([saleId])
}

model DebtPayment {
  id     String   @id @default(uuid())
  debtId String
  debt   Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount Float
  note   String   @default("")
  date   DateTime @default(now())
  // The bank credit that created this payment, when it came from matching an
  // incoming transfer to the customer's debt; null for manually recorded
  // payments. This is what lets UNMATCH reverse exactly the payments one credit
  // created and nothing else — without it, unmatching had to either leave the
  // money applied (the old bug) or guess by note text. Deliberately a bare
  // scalar, no @relation: a Transaction can be deleted with its business while
  // the payment history survives, and an FK would forbid that.
  transactionId String?
  // Chart of accounts: how it was paid (cash, transfer, pos...), the account the
  // money went into when picked, and when it was recorded (NULL on older rows).
  method           String?
  depositAccountId String?
  depositAccount   LedgerAccount? @relation("DebtPaymentDeposit", fields: [depositAccountId], references: [id], onDelete: SetNull)
  createdAt        DateTime?      @default(now())

  @@index([transactionId])
  @@index([depositAccountId])
}

model Payable {
  id           String           @id @default(uuid())
  businessId   String
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creditorName String
  category     String           @default("other")
  amount       Float
  paidAmount   Float            @default(0)
  dueDate      DateTime?
  note         String?
  date         DateTime         @default(now())
  paid         Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  payments     PayablePayment[]

  @@index([businessId, paid])
}

model PayablePayment {
  id        String   @id @default(uuid())
  payableId String
  payable   Payable  @relation(fields: [payableId], references: [id], onDelete: Cascade)
  amount    Float
  note      String?
  date      DateTime @default(now())
}

// A bill: what the business owes a supplier, a landlord or a lender (release
// 2, 2026-10-13, Zoho's bills; the table name is kept from payables). `name`
// is the vendor.
model BusinessDebt {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId      String?
  business        Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  name            String
  type            String    @default("other")
  originalAmount  Float
  remainingAmount Float
  dueDate         DateTime?
  note            String?
  status          String    @default("unpaid")
  reminderEnabled Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // The account the bill is for (an expense, or a liability such as Loans),
  // the bill's own date and number, and for a loan or other liability the
  // account the borrowed money went into. An estimated bill is a payable from
  // before bills: what was paid on it before is one estimated payment kept
  // outside the books.
  accountId            String?
  account              LedgerAccount? @relation("BillAccount", fields: [accountId], references: [id], onDelete: SetNull)
  billDate             DateTime       @default(now())
  billNumber           String?
  estimated            Boolean        @default(false)
  receivedViaAccountId String?
  receivedViaAccount   LedgerAccount? @relation("BillReceivedVia", fields: [receivedViaAccountId], references: [id], onDelete: SetNull)
  createdById          String?
  payments             BillPayment[]
  // Release 3: a restock's goods (its account is then Inventory Asset).
  items                BillItem[]

  @@index([userId, businessId])
  @@index([userId, status])
  @@index([businessId, updatedAt])
  @@index([accountId])
  @@index([receivedViaAccountId])
}

// A payment towards a bill. method: cash | transfer | pos | cheque | other |
// bank (CHECK in the migration). "bank" is money that left the KashBook
// account: the payment names that debit (transactionId, bare like
// DebtPayment.transactionId), and only a "bank" payment does; the debit carries
// matchedBillId and matchedAmount. outsideBooks: a payment from before bills,
// estimated, that only lowers what is owed and counts nowhere (it never names
// a debit).
model BillPayment {
  id                   String         @id @default(uuid())
  billId               String
  bill                 BusinessDebt   @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount               Float
  date                 DateTime       @default(now())
  method               String         @default("cash")
  paidThroughAccountId String?
  paidThroughAccount   LedgerAccount? @relation("BillPaymentPaidThrough", fields: [paidThroughAccountId], references: [id], onDelete: SetNull)
  transactionId        String?
  estimated            Boolean        @default(false)
  outsideBooks         Boolean        @default(false)
  note                 String?
  createdById          String?
  createdAt            DateTime       @default(now())

  @@index([billId])
  @@index([transactionId])
  @@index([paidThroughAccountId])
}

// One line of a restock bill (release 3): a goods item, how many came in and
// what one cost. amount is the line's value, quantity times unitCost to the
// kobo (utils/stock.js lineCost); the bill's amount is the sum of its lines
// and its account is Inventory Asset. Each line is one StockMovement
// "bill:<id>". An item a line names is never deleted: the migration makes
// that key NO ACTION, DEFERRABLE INITIALLY DEFERRED (Prisma does not show
// it), so deleting an owner still removes their bills' lines and their items
// in one statement.
model BillItem {
  id        String        @id @default(uuid())
  billId    String
  bill      BusinessDebt  @relation(fields: [billId], references: [id], onDelete: Cascade)
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: NoAction)
  quantity  Float
  unitCost  Float         @default(0)
  amount    Float         @default(0)
  position  Int           @default(0) // the order the lines were entered in
  createdAt DateTime      @default(now())

  @@index([billId])
  @@index([itemId])
}

model Sales {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId           String?
  customer             Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  businessId           String?
  business             Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  amount               Float
  currency             String    @default("NGN")
  paymentMethod        String    @default("cash")
  isCredit             Boolean   @default(false)
  notes                String?
  channel              String? // sales channel: instagram | whatsapp | walk-in | online | other
  matchedTransactionId String?
  recordedBy           String?
  recordedByName       String?
  date                 DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  // Chart of accounts: the income account (null = Sales), the account the
  // money went into (null = by payment method), and the app's retry key.
  accountId            String?
  account              LedgerAccount? @relation("SaleAccount", fields: [accountId], references: [id], onDelete: SetNull)
  depositAccountId     String?
  depositAccount       LedgerAccount? @relation("SaleDeposit", fields: [depositAccountId], references: [id], onDelete: SetNull)
  clientRef            String?
  // Release 3: what was sold, line by line (fixed once saved).
  items                SaleItem[]

  @@unique([businessId, clientRef])
  @@index([userId, businessId])
  @@index([businessId, date])
  @@index([businessId, updatedAt])
  @@index([businessId, channel])
  @@index([accountId])
  @@index([depositAccountId])
}

// One line of a sale (chart of accounts release 3, 2026-10-13), fixed once
// saved: delete the sale and record it again. name is a snapshot of the
// item's name; itemType: goods | service | other (a typed line that names no
// item; CHECK in the migration). accountId: the income account the line
// counts as (chart.incomeForItem when none was picked). unitCost is null
// unless the line is goods with a known cost; costAmount is what the goods
// that left cost (the StockMovement "sale:<id>" carries the same value,
// negative). Quantities have at most three decimals.
model SaleItem {
  id         String         @id @default(uuid())
  saleId     String
  sale       Sales          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  itemId     String?
  item       InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name       String
  itemType   String         @default("other")
  quantity   Float
  rate       Float          @default(0)
  amount     Float          @default(0)
  accountId  String?
  account    LedgerAccount? @relation("SaleItemAccount", fields: [accountId], references: [id], onDelete: SetNull)
  unitCost   Float?
  costAmount Float          @default(0)
  position   Int            @default(0) // the order the lines were entered in
  // Items like Zoho (2026-10-14): false only on a line of goods whose stock is
  // not counted (InventoryItem.trackInventory off), which moves no stock and
  // carries no cost. Always the item's own, since tracking is fixed once used.
  tracked    Boolean        @default(true)
  createdAt  DateTime       @default(now())

  @@index([saleId])
  @@index([itemId])
  @@index([businessId])
  @@index([accountId])
}

model Expense {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  category      String    @default("other")
  amount        Float
  currency      String    @default("NGN")
  paymentMethod String    @default("cash")
  date          DateTime  @default(now())
  notes         String?
  // The outbound bank transfer this expense records, when it was created from
  // one ("tap a transfer you sent → record it as an expense"). Mirrors
  // Sales.matchedTransactionId: bare scalar, no FK, no unique — the code guards
  // one-expense-per-transfer under the business lock.
  matchedTransactionId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Chart of accounts: the account the money was spent on (null = the
  // category's account), the account it was paid from (null = by method), and
  // the app's retry key.
  accountId            String?
  account              LedgerAccount? @relation("ExpenseAccount", fields: [accountId], references: [id], onDelete: SetNull)
  paidThroughAccountId String?
  paidThroughAccount   LedgerAccount? @relation("ExpensePaidThrough", fields: [paidThroughAccountId], references: [id], onDelete: SetNull)
  clientRef            String?
  // Zoho-style details (2026-10-12): the supplier's receipt or invoice number
  // (100 characters at most), the customer the cost was for (it shows on their
  // page and changes no total), up to 5 receipts kept privately on Cloudinary
  // ([{ id, name, mime, size, uploadedAt, publicId, resourceType }]; clients
  // never get publicId or resourceType: utils/expenseView.js), and the lines of
  // an itemized expense (amount = their sum, accountId null, category = the
  // first line's, so older app versions still show it whole).
  reference            String?
  customerId           String?
  customer             Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  attachments          Json?
  items                ExpenseItem[]

  @@unique([businessId, clientRef])
  @@index([userId, businessId])
  @@index([businessId, date])
  @@index([businessId, updatedAt])
  @@index([accountId])
  @@index([paidThroughAccountId])
  @@index([customerId])
}

// One line of an itemized expense (Zoho's "Itemize"). The books rule counts an
// itemized expense line by line, each by its own account: a line on equipment,
// rent paid ahead, a loan repaid or drawings is not spending.
model ExpenseItem {
  id          String         @id @default(uuid())
  expenseId   String
  expense     Expense        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  accountId   String?
  account     LedgerAccount? @relation("ExpenseItemAccount", fields: [accountId], references: [id], onDelete: SetNull)
  category    String         @default("other") // the account's categorySlug, else "other" (like Expense.category)
  description String?
  amount      Float
  position    Int            @default(0) // the order the merchant entered the lines in
  createdAt   DateTime       @default(now())

  @@index([expenseId])
  @@index([accountId])
}

model Transaction {
  id                String    @id @default(uuid())
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type              String
  amount            Float
  description       String?
  category          String?
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  date              DateTime
  paymentMethod     String    @default("cash")
  matchedSaleId     String?
  matchedCustomerId String?
  // Expense mirror of matchedSaleId, for OUTBOUND transfers: the Expense row
  // recorded from this debit. Expense aggregates exclude debits carrying this,
  // exactly as income aggregates exclude matched credits.
  matchedExpenseId  String?
  // A credit that paid one or more invoices: the first invoice it paid. The
  // InvoicePayment rows carrying transactionId = this row are the full list,
  // and matchedAmount is their sum, so a larger credit's remainder still counts.
  matchedInvoiceId  String?
  // A debit that paid a bill (release 2): the bill whose BillPayment names
  // this row. Bare, like matchedExpenseId; matchedAmount is the payment.
  matchedBillId     String?
  // How much of this bank row the match actually accounted for (sale amount,
  // debt applied, expense recorded) — always ≤ amount. Scalar totals add the
  // unmatched remainder (amount − matchedAmount) back in, so a ₦5,000 credit
  // that paid a ₦3,000 debt doesn't silently drop ₦2,000 from income. NULL on
  // matches made before this column existed = treated as fully matched.
  matchedAmount     Float?
  // Structured counterparty for INBOUND credits, captured at booking time
  // (the same values that get flattened into description). These are what
  // match ranking and sender-recall key on; never render account numbers
  // unmasked in UI.
  senderName        String?
  senderBank        String?
  senderAccount     String?
  recordedBy        String?
  recordedByName    String?
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  source            String?
  channel           String? // sales channel: instagram | whatsapp | walk-in | online | other
  // Deterministic idempotency key for Anchor-sourced money movement (transfers,
  // bills, inbound credits). The @@unique below makes "record this once" atomic:
  // a duplicate insert fails with P2002 instead of double-spending/double-crediting.
  // Null for manual/offline transactions (Postgres allows many nulls).
  reference         String?
  // Immutable provider-side identifier for this money movement (Anchor payment
  // id, transaction id or transfer id). `reference` is our own idempotency key
  // and gets re-keyed when a webhook repairs a reconcile-booked row; this one
  // records what the PROVIDER called it, so a row can always be traced back to
  // the source event without parsing the description.
  providerTxnId     String?
  // Why this bank row exists when it is NOT trade (utils/books.js PURPOSES):
  // "savings_fee" (savings early-withdrawal charge), "customer_refund" (a
  // debit that paid a credit-note refund; the refund lowers sales instead), or
  // a credit the merchant marked as not income: "cash_deposit", "own_transfer",
  // "owner_money", "loan", "supplier_refund" (this one lowers expenses).
  // Set only by server routes. Reporting aggregates exclude rows carrying a
  // purpose; the ledger balance keeps them, because the money moved.
  purpose           String?
  currency          String    @default("NGN") // base currency at time of record; per-business default
  flagSeverity      String? // null | "low" | "medium" | "high"
  complianceStatus  String    @default("clean") // "clean" | "flagged" | "held" | "cleared"
  // Outbound-transfer fee charged to the user (₦51/₦101 pass-through + margin).
  // `amount` stays the transfer amount so income/expense reports are truthful;
  // the fee is its own field. Zero for everything that isn't an external transfer.
  fee               Float     @default(0)
  feeBreakdown      Json? // { nip, stampDuty, platform }
  // Chart of accounts: the account the merchant explained this row with (an
  // income or expense account, or one on the balance sheet). Null = by purpose,
  // payroll / auto-debit reference, or unexplained (utils/chart.js).
  accountId         String?
  account           LedgerAccount? @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([businessId, reference])
  @@index([businessId, providerTxnId])
  @@index([businessId, date])
  @@index([userId])
  @@index([businessId, updatedAt])
  @@index([complianceStatus, flagSeverity])
  @@index([businessId, channel])
  @@index([accountId])
  @@index([matchedBillId])
}

// Idempotency ledger for inbound Anchor webhooks. We insert the provider event
// id BEFORE acting on it; a duplicate delivery hits the @unique and is skipped,
// so a credit/debit is processed exactly once regardless of re-delivery.
model ProcessedWebhook {
  id         String   @id @default(uuid())
  eventId    String   @unique
  type       String?
  receivedAt DateTime @default(now())
}

// ── Instagram DM cache ───────────────────────────────────────────────────────
// Meta stays the source of truth for messages; we keep a thin local cache so the
// in-app inbox renders fast and unread state survives a relaunch. Populated by
// the webhook (inbound) and by our own send calls (outbound). One conversation
// per (business, IG-scoped customer id) — webhook message events give us the
// participant IGSID but not always a thread id, so the IGSID is the stable key
// and igThreadId is filled lazily from the Conversations API.
model IgConversation {
  id                     String      @id @default(uuid())
  businessId             String
  business               Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  participantIgId        String // the customer's IG-scoped user id (IGSID) — stable key
  igThreadId             String? // Meta conversation id, when known
  participantUsername    String?
  // Stable link to the bookkeeping Customer (set on first record-sale / invoice).
  // Used instead of matching by display name, which can collide.
  customerId             String?
  customer               Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lastMessageAt          DateTime    @default(now())
  // Last time the CUSTOMER messaged us — gates the 24h standard / 7d HUMAN_AGENT
  // send window (Meta blocks replies outside it). Distinct from lastMessageAt,
  // which also moves on our own outbound replies. See docs/INSTAGRAM_API_SPEC.md §4.
  lastInboundAt          DateTime?
  // Auto payment confirmation: when the merchant sends a "Request ₦X" in this
  // thread we store the expected amount + time. An inbound NUBAN credit that
  // matches it (within 48h, exactly one candidate) auto-replies "payment
  // received", clears these, and stamps lastPaymentConfirmedAt. See
  // server/src/utils/igPaymentMatch.js.
  expectedAmount         Float?
  expectedSince          DateTime?
  lastPaymentConfirmedAt DateTime?
  unread                 Boolean     @default(false)
  createdAt              DateTime    @default(now())
  messages               IgMessage[]

  @@unique([businessId, participantIgId])
  @@index([businessId, lastMessageAt])
  // Supports the auto-payment matcher's per-business "armed conversations" query
  // (WHERE businessId=? AND expectedAmount IS NOT NULL …), run on every credit.
  @@index([businessId, expectedAmount])
}

// Automated IG DM replies. "greeting" fires once on a conversation's first
// inbound message; "keyword" fires when an inbound message contains the keyword.
model IgAutoReply {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       String // "greeting" | "keyword" | "comment" | "away"
  keyword    String? // for kind="keyword"/"comment" (matched case-insensitively; null comment = any)
  text       String   @db.VarChar(900)
  fromHour   Int? // for kind="away": window start hour 0-23 (Africa/Lagos)
  toHour     Int? // for kind="away": window end hour 0-23
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([businessId])
}

// Saved canned replies a merchant can insert into an IG DM with one tap.
model QuickReply {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  text       String   @db.VarChar(900) // DB-enforced cap (route also validates ≤900)
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model IgMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   IgConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  igMessageId    String         @unique // Meta message id (mid) — dedups redelivered webhooks
  direction      String // "in" (from customer) | "out" (from merchant)
  text           String?
  attachmentUrl  String? // inbound image/media URL (temporary, signed by Meta)
  sentAt         DateTime       @default(now())

  @@index([conversationId, sentAt])
}

// ── WhatsApp DM cache (Cloud API) ────────────────────────────────────────────
// Mirrors IgConversation/IgMessage. One conversation per (business, customer
// wa_id/phone). Populated by the webhook (inbound) and our own sends (outbound).
// Carries the same auto-payment-confirm fields and stable customer link the IG
// models gained through review — included from day one here.
model WaConversation {
  id                     String      @id @default(uuid())
  businessId             String
  business               Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  participantPhone       String // the customer's wa_id (E.164 digits) — stable key
  participantName        String? // WhatsApp profile name
  customerId             String?
  customer               Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lastMessageAt          DateTime    @default(now())
  lastInboundAt          DateTime? // gates the 24h free-form send window
  expectedAmount         Float?
  expectedSince          DateTime?
  lastPaymentConfirmedAt DateTime?
  unread                 Boolean     @default(false)
  createdAt              DateTime    @default(now())
  messages               WaMessage[]

  @@unique([businessId, participantPhone])
  @@index([businessId, lastMessageAt])
  @@index([businessId, expectedAmount])
  @@index([customerId])
}

model WaMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  waMessageId    String         @unique // wamid — dedups redelivered webhooks
  direction      String // "in" | "out"
  text           String?
  attachmentUrl  String? // re-hosted media URL (media download needs auth — later batch)
  sentAt         DateTime       @default(now())

  @@index([conversationId, sentAt])
}

model InventoryItem {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  unit          String    @default("piece")
  price         Float
  cost          Float? // unused since release 3 (scripts/backfill-r3.js reads it once): stockValue and avgCost hold the cost
  quantity      Float     @default(0) // at most three decimals (2.5 kg); never below 0 (CHECK in the migration)
  lowStockAlert Int       @default(5)
  category      String?
  sku           String?
  barcode       String?
  image         String?
  lastRestocked DateTime?
  createdBy     String?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Chart of accounts, release 3 (2026-10-13). itemType: goods | service
  // (CHECK in the migration). For goods, stockValue is what the stock on hand
  // cost (naira, kobo-exact, never below 0) and avgCost the last known average
  // cost of one unit (kept when the quantity reaches 0; null: never known);
  // only utils/stock.js changes quantity, stockValue and avgCost, always with
  // a StockMovement. incomeAccountId: the income account its sales count as
  // (null: Sales for goods, Service Income for a service: chart.incomeForItem).
  // lowStockNotifiedAt: the low-stock alert went out (cleared when the
  // quantity rises above lowStockAlert). archivedAt: an item with history is
  // archived, never deleted.
  itemType           String         @default("goods")
  stockValue         Float          @default(0)
  avgCost            Float?
  incomeAccountId    String?
  incomeAccount      LedgerAccount? @relation("ItemIncomeAccount", fields: [incomeAccountId], references: [id], onDelete: SetNull)
  lowStockNotifiedAt DateTime?
  archivedAt         DateTime?
  // Items like Zoho (2026-10-14). trackInventory: whether goods' stock is
  // counted (always false for a service; goods not counted hold no stock, no
  // value and no avgCost: CHECKs in the migration). Fixed once the item is
  // used. returnable: counted goods may come back into stock on a credit
  // note. Purchase information (purchasePrice for one unit, naira;
  // purchaseDescription; purchaseAccountId, null: Cost of Goods Sold for goods,
  // Cost of Services for a service; preferredSupplier) is a cost: only the
  // owner and members with canViewReports see it. More information: brand,
  // manufacturer, weight + weightUnit (kg | g | lb | oz), length, width,
  // height + dimensionUnit (cm | m | in), upc, ean, isbn, mpn. A variant names
  // its group (groupId), its option per attribute in the group's order
  // (variantValues, a list of text) and the same lower-cased and joined with
  // U+001F (variantKey, unique per group).
  trackInventory      Boolean        @default(true)
  returnable          Boolean        @default(false)
  purchasePrice       Float?
  purchaseDescription String?
  purchaseAccountId   String?
  purchaseAccount     LedgerAccount? @relation("ItemPurchaseAccount", fields: [purchaseAccountId], references: [id], onDelete: SetNull)
  preferredSupplier   String?
  brand               String?
  manufacturer        String?
  weight              Float?
  weightUnit          String?
  length              Float?
  width               Float?
  height              Float?
  dimensionUnit       String?
  upc                 String?
  ean                 String?
  isbn                String?
  mpn                 String?
  groupId             String?
  group               ItemGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  variantValues       Json?
  variantKey          String?
  saleItems          SaleItem[]
  invoiceItems       InvoiceItem[]
  billItems          BillItem[]
  movements          StockMovement[]

  @@index([userId, businessId])
  @@index([businessId, updatedAt])
  @@index([incomeAccountId])
  @@index([purchaseAccountId])
  @@index([groupId])
  @@unique([groupId, variantKey])
  // A barcode identifies ONE product within a business. Scoped per business,
  // not globally, because two shops legitimately stock the same product and a
  // global constraint would stop the second one recording it.
  //
  // Postgres permits many NULLs in a unique index, so products without a
  // barcode — today that is all of them — are unaffected.
  @@unique([businessId, barcode])
}

// Items like Zoho (2026-10-14): an item with variants. What the variants of
// one product share (type, unit, trackInventory, returnable, the
// descriptions, the accounts, the preferred supplier, brand, manufacturer) is
// kept here and copied to every variant, changed only through the group
// (routes/itemGroups.js). attributes: [{ name, options: [text] }], 1 to 3, in
// the order the variants' values follow. clientRef makes a retried create
// safe. archivedAt: the group and its variants are archived together.
// purchaseDescription, purchaseAccountId and preferredSupplier are costs, as
// on an item. CHECKs in the migration as for items.
model ItemGroup {
  id                  String          @id @default(uuid())
  businessId          String
  business            Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  itemType            String          @default("goods")
  unit                String
  trackInventory      Boolean         @default(true)
  returnable          Boolean         @default(false)
  description         String?
  purchaseDescription String?
  preferredSupplier   String?
  brand               String?
  manufacturer        String?
  incomeAccountId     String?
  incomeAccount       LedgerAccount?  @relation("ItemGroupIncomeAccount", fields: [incomeAccountId], references: [id], onDelete: SetNull)
  purchaseAccountId   String?
  purchaseAccount     LedgerAccount?  @relation("ItemGroupPurchaseAccount", fields: [purchaseAccountId], references: [id], onDelete: SetNull)
  attributes          Json
  image               String?
  clientRef           String?
  archivedAt          DateTime?
  createdById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  items               InventoryItem[]

  @@unique([businessId, clientRef])
  @@index([businessId, updatedAt])
  @@index([userId])
  @@index([incomeAccountId])
  @@index([purchaseAccountId])
}

// Recurring invoices — PREMIUM. A rule auto-creates a SENT invoice (+ share
// link) for a customer on a schedule (same frequency strings + nextDue/active
// discipline as RecurringExpense; processed by utils/recurringInvoiceRunner.js).
model RecurringInvoice {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  description   String // the invoice line item, e.g. "Weekly supply"
  amount        Float
  frequency     String    @default("monthly") // daily | weekly | monthly | yearly | custom_N
  dueInDays     Int? // dueDate = issueDate + N days; null = no due date
  nextDue       DateTime
  active        Boolean   @default(true)
  lastRunAt     DateTime?
  lastInvoiceId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, active])
  @@index([nextDue, active])
}

model RecurringExpense {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId          String?
  business            Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  category            String    @default("other")
  amount              Float
  paymentMethod       String    @default("cash")
  notes               String?
  frequency           String    @default("monthly")
  nextDue             DateTime
  active              Boolean   @default(true)
  // ── Auto-debit (off by default; backwards-compatible) ──────────────────
  autoSend            Boolean   @default(false)
  authorizedAt        DateTime?
  payeeAccountNumber  String?
  payeeBankCode       String?
  payeeBankName       String?
  payeeAccountName    String?
  lastAutoSendAt      DateTime?
  lastAutoSendStatus  String? // "ok" | "insufficient_balance" | "blocked_aml" | "anchor_error" | "above_cap" | "skipped_paused"
  lastAutoSendRef     String?
  consecutiveFailures Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Chart of accounts: copied onto every expense the rule records.
  accountId            String?
  account              LedgerAccount? @relation("RecurringAccount", fields: [accountId], references: [id], onDelete: SetNull)
  paidThroughAccountId String?
  paidThroughAccount   LedgerAccount? @relation("RecurringPaidThrough", fields: [paidThroughAccountId], references: [id], onDelete: SetNull)

  @@index([userId, active])
  @@index([nextDue, active])
  @@index([active, autoSend])
  @@index([accountId])
  @@index([paidThroughAccountId])
}

model OtpCode {
  id         String   @id @default(uuid())
  identifier String
  type       String
  // HMAC-SHA256(identifier:code) keyed with a server secret — never plaintext.
  code       String
  expiresAt  DateTime
  used       Boolean  @default(false)
  // Failed verification counter. The send-side throttle never limited GUESSING,
  // so a 6-digit code was brute-forceable given enough source IPs. The code is
  // burned at MAX_OTP_ATTEMPTS misses (utils/otp.js).
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([identifier, type])
}

model Reminder {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  targetId      String?
  type          String    @default("debt")
  amount        Float     @default(0)
  recipientName String    @default("")
  phone         String?
  message       String?   @db.Text
  channel       String    @default("sms")
  status        String    @default("pending")
  scheduledFor  DateTime
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, scheduledFor])
  @@index([userId])
}

model Suggestion {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("feature")
  content   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id             String            @id @default(uuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId         String
  invoiceNumber  String
  type           String            @default("invoice") // "invoice" | "quote" (quotes convert to invoices)
  status         InvoiceStatus     @default(DRAFT)
  issueDate      String
  dueDate        String?
  currency       String            @default("NGN")
  subtotal       Float             @default(0)
  taxRate        Float             @default(0)
  taxAmount      Float             @default(0)
  discountType   String?
  discountValue  Float             @default(0)
  discountAmount Float             @default(0)
  total          Float             @default(0)
  amountPaid     Float             @default(0)
  notes          String?
  terms          String? // Terms & Conditions text (not the payment terms below)
  template       String            @default("classic")
  // due_on_receipt | net_15 | net_30 | net_45 | net_60 | due_end_of_month |
  // due_end_of_next_month | custom. The client derives dueDate from it.
  paymentTerms   String?
  orderNumber    String? // the customer's PO / reference number
  subject        String?
  salespersonId  String? // the owner or one of their staff; no FK on purpose
  salespersonName String? // copied at save time so the document keeps it
  // Invoices only: the unpaid balance the merchant gave up on. Stays a sale in
  // the "when sold" view and adds a bad-debt expense there on writtenOffAt;
  // the invoice is closed (no payments, not "owed to you").
  writtenOffAt     DateTime?
  writtenOffAmount Float?
  // The tax authority's invoice reference (NRS e-invoicing IRN), when issued.
  irn            String?
  // The customer's addresses and TIN as they were when this document was
  // saved (utils/customerFields.js customerSnapshot): a later edit to the
  // customer never rewrites an issued document.
  billingAddress  Json?
  shippingAddress Json?
  customerTaxId   String?
  items          InvoiceItem[]
  payments       InvoicePayment[]
  shareLink      InvoiceShareLink?
  // Credit notes only: credit this note gave to invoices.
  creditsGiven    CreditApplication[] @relation("CreditGiven")
  // Invoices only: credit notes applied to this invoice.
  creditsReceived CreditApplication[] @relation("CreditReceived")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([businessId, userId])
  @@index([businessId, status])
  @@index([businessId, updatedAt])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  quantity    Float   @default(1)
  rate        Float   @default(0)
  amount      Float   @default(0)
  // Chart of accounts: the income account this line counts as (null = Sales).
  accountId   String?
  account     LedgerAccount? @relation("InvoiceItemAccount", fields: [accountId], references: [id], onDelete: SetNull)
  // Release 3: the item the line is for (null: a typed line), its type
  // (goods | service | other; null on older lines: other), what one unit cost
  // (null unless goods with a known cost) and what the goods that left cost.
  // On a credit note, restock: the goods come back into stock (costAmount is
  // then the cost that came back, positive).
  itemId      String?
  item        InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemType    String?
  unitCost    Float?
  costAmount  Float          @default(0)
  restock     Boolean        @default(false)
  // Items like Zoho (2026-10-14): false only on a line of goods whose stock is
  // not counted, which never moves stock and carries no cost.
  tracked     Boolean        @default(true)

  @@index([accountId])
  @@index([itemId])
}

// Credit from a credit note (an Invoice with type "credit_note") applied to an
// invoice of the same customer. The invoice also carries an InvoicePayment
// with method "credit_note"; this row links the two documents. Document links
// are NO ACTION so a document with credit attached cannot be deleted alone.
model CreditApplication {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creditNoteId String
  creditNote   Invoice  @relation("CreditGiven", fields: [creditNoteId], references: [id], onDelete: NoAction)
  invoiceId    String
  invoice      Invoice  @relation("CreditReceived", fields: [invoiceId], references: [id], onDelete: NoAction)
  amount       Float
  date         DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([creditNoteId])
  @@index([invoiceId])
  @@index([businessId])
}

model InvoicePayment {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("cash")
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  // The bank row this payment is: the NUBAN credit that paid the invoice
  // (method "bank") or the debit that paid a credit-note refund
  // (method "refund_bank"). Bare scalar, like DebtPayment.transactionId.
  transactionId String?
  // Chart of accounts: the account the money went into (null = by method).
  depositAccountId String?
  depositAccount   LedgerAccount? @relation("InvoicePaymentDeposit", fields: [depositAccountId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([depositAccountId])
}

model InvoiceShareLink {
  id        String   @id @default(cuid())
  invoiceId String   @unique
  token     String   @unique
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([token])
}

enum Plan {
  FREE
  PREMIUM
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  OWNER
  STAFF
}

enum KycSubmissionStatus {
  PENDING // awaiting admin review
  APPROVED // admin approved; Anchor provisioning ran
  DECLINED // admin declined (declineReason set); user may resubmit
  FAILED // approved but validation/Anchor failed; admin can retry
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
}

// Append-only audit log — used for every state-changing or security-relevant
// action. Reviewed by admins via the compliance dashboard.
model AuditLog {
  id           String   @id @default(cuid())
  actorType    String // "user" | "admin" | "system"
  actorId      String?
  action       String
  resourceType String?
  resourceId   String?
  ip           String?
  userAgent    String?
  metadata     Json?
  severity     String   @default("info") // "info" | "warn" | "alert"
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([severity, createdAt])
  @@index([createdAt])
  @@index([action, createdAt])
}

// Open-review queue for the compliance team. Rules engine writes here; admins
// transition status to cleared/escalated/frozen.
// Per-staff capability grants, managed by the business owner.
//
// THE ROW'S EXISTENCE IS THE GRANT. No row means no permissions, so on the day
// this ships every existing staff member has exactly zero new access and there
// is no NULL-column path that could read as "allowed". Every flag additionally
// defaults false, so even a half-written row cannot grant anything.
//
// A separate table rather than columns on User, deliberately:
//   * it is the most additive change possible on a database shared with another
//     deployed app — a brand-new table it has never heard of, no ALTER TABLE
//     against anything it reads;
//   * User is the hottest row in the system (atomic PIN-attempt increments,
//     tokenVersion bumps on revoke), and permission writes should not contend
//     with security-critical ones;
//   * a JSON blob would be worse still: a PATCH that omits a key silently
//     revokes it, and any defaulting written as `!== false` would fail OPEN on
//     the money permission.
model StaffPermission {
  id         String @id @default(uuid())
  userId     String @unique // the STAFF User.id
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerId String // denormalised owner id — the tenant key, and cross-checked
  //                   against User.employerId at read time so a stale grant from
  //                   a previous employer can never be honoured.

  canViewBalance    Boolean @default(false) // the account number AND the balance
  canTransfer       Boolean @default(false) // send money, subject to dailyTransferCap
  canViewReports    Boolean @default(false) // reports and insights
  canManagePayables Boolean @default(false) // add suppliers, record payments

  // Autonomous spend ceiling over a ROLLING 24 hours (not a calendar day — a
  // midnight reset would let a staff member spend the cap twice inside two
  // minutes; see utils/staffTransferCap.js). null or 0 means every transfer
  // needs the owner's approval. There is deliberately NO "unlimited" value:
  // uncapped staff spending is not a state this system should be able to express.
  dailyTransferCap Float?

  grantedById String // the owner who last changed this, for the audit trail
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employerId])
}

// A staff transfer that exceeded the staff member's daily cap and is waiting on
// the owner. This is deliberately NOT a Transaction row with complianceStatus
// "held": computeRawLedger (utils/ledgerBalance.js) sums Transaction filtered on
// businessId/paymentMethod/currency/source/type/category and does NOT filter on
// complianceStatus, so a pending transfer parked there would immediately reduce
// the spendable balance for money that never left, and could trip the
// pooled-wallet coverage alarm in alerts.js. Money that has not moved does not
// belong in the ledger.
model StaffTransferRequest {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedById String // the STAFF User.id
  ownerId       String // denormalised, so the owner's pending list is one indexed read

  // Frozen copy of the transfer as requested. Deliberately a snapshot, not a
  // reference: what the owner approves must be exactly what was asked for, even
  // if the beneficiary record is edited in between.
  accountNumber String
  bankCode      String
  bankName      String?
  // Resolved by NAME ENQUIRY at hold time, not copied from the staff member's
  // request body. If the enquiry failed, this is their supplied name and
  // nameVerified is false, which the owner's approval sheet must surface —
  // approving a name nobody checked is the whole risk this queue exists to
  // manage.
  accountName   String?
  nameVerified  Boolean @default(false)
  amount        Float
  narration     String?
  currency      String  @default("NGN")

  // pending → approved → executed, or pending → rejected | cancelled | expired,
  // or approved → failed (the provider refused after the owner said yes).
  // Terminal states are never revisited. Claimed atomically with an updateMany
  // guarded on the previous status, so a double-tap cannot execute twice.
  status String @default("pending")
  reason String? // why it was held, or the rejection reason the staff member sees

  // Minted at request time and carried through to execution, so approving twice
  // hits the executor's existing-reference short-circuit rather than sending
  // twice. Unique across the table as a second line of defence.
  idempotencyKey String @unique

  // The cap this was measured against, kept for the audit trail: the owner may
  // change the cap after the fact and the record should still explain itself.
  capAtRequest   Float?
  spentAtRequest Float?

  decidedById           String? // the owner who approved or rejected
  decidedAt             DateTime?
  executedTransactionId String? // set on success; the daily-cap query excludes
  //                               these, because money the owner personally
  //                               approved was not unsupervised spend
  executedReference     String?
  failureReason         String?

  // Approvals go stale. A transfer the owner authorises days later, at a price
  // and for a reason they no longer hold in mind, is worse than one that lapsed
  // and had to be asked for again.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([businessId, status])
  @@index([requestedById, status])
  @@index([status, expiresAt])
}

model ComplianceFlag {
  id            String    @id @default(uuid())
  userId        String
  businessId    String?
  transactionId String?
  ruleCode      String
  severity      String // "low" | "medium" | "high"
  description   String
  metadata      Json
  status        String    @default("open") // "open" | "cleared" | "escalated" | "frozen"
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewerNote  String?
  createdAt     DateTime  @default(now())

  @@index([status, severity, createdAt])
  @@index([userId])
  @@index([transactionId])
}

// ── Observability ─────────────────────────────────────────────────────────────
// Health/analytics history snapshots, cron heartbeats and alert-cooldown state.
// Exception tracking is handled by Sentry (see server/src/instrument.js), not in
// the DB. See server/src/utils/{metrics,healthCheck,alerts}.js.

model MetricSnapshot {
  id      String   @id @default(uuid())
  kind    String // "health" | "analytics"
  takenAt DateTime @default(now())
  data    Json

  @@index([kind, takenAt])
}

model CronHeartbeat {
  name       String   @id // cron identifier
  lastRunAt  DateTime
  lastStatus String   @default("ok") // "ok" | "error"
  lastError  String?
}

model AlertState {
  key         String   @id // alert rule key
  lastFiredAt DateTime
  lastValue   String?
}

// ─── Staff Payments ──────────────────────────────────────────────────────────
// Scheduled salary. NOT a payroll system: it sends the amount the owner typed
// and handles no PAYE, pension or payslips — the UI says so, because a product
// that merely IMPLIES it remits statutory deductions is worse than one that
// doesn't offer them.
//
// Deliberately NOT modelled as a RecurringExpense + staffUserId, for three
// reasons that are each load-bearing:
//   1. `GET /recurring-expenses` is scoped by ownerIdOf(req), which resolves a
//      STAFF caller to their employer — every salary row would be listed to any
//      staff member who reached that screen. A table no existing route selects
//      from is invisible by construction, rather than by a negative filter that
//      fails open the day someone forgets it.
//   2. RecurringExpense.autoSend is UNATTENDED (recurringExpenseRunner.js calls
//      executeTransfer directly). Salary is attended: the owner approves each
//      payment. Bolting that branch into the live auto-debit runner would widen
//      the blast radius on a money path that currently works.
//   3. Its consent model is the bug we must not inherit: `authorizedAt` is
//      written and never read, and its PIN triggers cover a payee change but NOT
//      an amount change.

// The standing arrangement. The payout bank details live HERE and never on
// User: User has no money identity, and it lives in a database shared with
// another deployed app (see the comment on User.employerId).
model SalarySchedule {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ownerId    String // denormalised tenant key; the owner's list is one indexed read

  // Bare String, NO foreign key. Staff are HARD deleted (auth.js DELETE
  // /staff/:id), so a Cascade would vaporise payment history and a Restrict
  // would break the delete route. The name snapshot keeps history readable
  // after the User row is gone.
  staffUserId       String
  staffNameSnapshot String

  // ── Where the money goes ──
  // `payoutKind` is the Phase 2 seam: "external_bank" today, "kashbook_internal"
  // once staff have their own accounts. executeTransfer already detects an
  // internal KashBook NUBAN and books a free instant transfer, and
  // computeTransferFee(amount, "book") already returns 0 — so the rail swap is
  // one branch, not a migration.
  payoutKind    String  @default("external_bank")
  accountNumber String
  bankCode      String
  bankName      String?
  // Resolved by BANK NAME ENQUIRY server-side, never copied from a request
  // body. A client-supplied payee name makes an approval queue look like
  // oversight while providing none.
  accountName   String
  nameVerified  Boolean @default(false)

  amount   Float
  currency String @default("NGN")

  // ── Schedule. An ANCHOR, not a cursor. ──
  // Nothing is computed from the last payment, so nothing can drift: a 31st
  // anchor pays 28 Feb and then 31 Mar again. computeNextDue() in
  // recurringSchedule.js is naive interval addition and drifts permanently
  // (Jan 31 → Mar 2/3 forever); it is deliberately not used here.
  frequency       String   @default("monthly") // monthly | weekly
  anchorDay       Int // 1..31 for monthly, 0..6 for weekly
  businessDayRule String   @default("before") // weekend payday pays EARLY, never late
  nextRunDate     DateTime

  // ── Consent, bound to BOTH the amount and the payee ──
  // Written only by a PIN-verified write, and READ by the runner: a schedule
  // whose amount no longer matches what was authorised mints nothing. That puts
  // the consent check at the point of money, not just on the edit route, so a
  // future code path that writes `amount` without a PIN still cannot pay anyone.
  authorizedAt     DateTime
  authorizedAmount Float
  authorizedPayee  String // `${accountNumber}:${bankCode}` at PIN time

  status                   String  @default("active") // active | paused | suspended
  pausedReason             String?
  consecutiveUnpaidPeriods Int     @default(0)
  lastRunAt                DateTime?
  lastRunStatus            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One salary per person, enforced by the database. Scoped to the OWNER rather
  // than the business: a staff member has exactly one employer, so a two-
  // business owner must not be able to schedule the same person twice.
  @@unique([ownerId, staffUserId])
  @@index([status, nextRunDate])
  @@index([ownerId, status])
  @@index([businessId, status])
}

// One row per staff member per pay PERIOD — the object the owner approves.
model SalaryPayment {
  id String @id @default(uuid())

  // Bare String, no FK: payment history must outlive the instruction that
  // created it. The row is self-describing.
  scheduleId String
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ownerId    String

  staffUserId       String
  staffNameSnapshot String

  // Frozen snapshot of the terms AND the destination. What the owner approves
  // must be exactly what was presented, even if the schedule is edited in
  // between.
  amount        Float
  currency      String  @default("NGN")
  payoutKind    String  @default("external_bank")
  accountNumber String
  bankCode      String
  bankName      String?
  accountName   String?
  nameVerified  Boolean @default(false)

  periodKey    String // "2026-09" | "2026-W38", computed in Africa/Lagos
  scheduledFor DateTime

  // pending → approving → paid | failed, or pending → rejected | expired | skipped.
  // `failed` is TERMINAL and AMBIGUOUS: it means a human must check with the
  // bank before sending again. It is never re-offered automatically.
  status        String  @default("pending")
  reason        String?
  failureReason String?

  // Is this period still OWED? Expiry and rejection leave it true so an unpaid
  // period stays visible; only an explicit skip clears it. The recurring engine
  // silently advanced its cursor past a skipped period and that money simply
  // vanished from the record.
  owed Boolean @default(true)

  // Deterministic and derived from data alone, so it is stable across every
  // retry and distinct across every period. Handed to executeTransfer as
  // `reference`, landing under Transaction @@unique([businessId, reference]).
  reference String

  // Set by one approve call, identifying exactly the rows THAT call claimed, so
  // a single guarded updateMany can claim a batch atomically and still give
  // per-row ownership.
  claimToken String?

  expiresAt   DateTime
  decidedById String?
  decidedAt   DateTime?
  paidAt      DateTime?

  executedTransactionId String?
  executedReference     String?
  feeCharged            Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // THE anti-double-pay constraint, enforced by Postgres rather than by
  // application logic: one payment per person per period, forever. A schedule
  // paused for three months and resumed can only ever produce named periods —
  // never one payment per daily cron tick, which is exactly how the recurring
  // engine's backlog catch-up can double-pay today.
  @@unique([scheduleId, periodKey])
  @@unique([businessId, reference])
  @@index([ownerId, status])
  @@index([status, expiresAt])
  @@index([businessId, status])
}

// ── Chart of accounts (2026-10-11) ───────────────────────────────────────────
// Zoho Books' accounts, adapted for a Nigerian shop: types, the default chart
// and the rules for records without an account are in utils/chart.js. The
// ledger is derived from the records (utils/ledger.js); nothing posts here.
model LedgerAccount {
  id           String          @id @default(uuid())
  businessId   String
  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type         String // chart.js ACCOUNT_TYPES (CHECK constraint in the migration)
  name         String
  nameKey      String // lower(trim(name)): names are unique per business
  code         String?
  codeKey      String? // lower(trim(code)): codes are unique per business when set
  description  String?
  systemKey    String? // an account the books post to by themselves (chart.js SYS)
  categorySlug String? // the expense category this account stands for
  aliasSlugs   String[]        @default([]) // older categories merged into this account: each stands for it too
  seed         String? // the default chart key the app translates the name by; null once renamed
  parentId     String?
  parent       LedgerAccount?  @relation("SubAccounts", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     LedgerAccount[] @relation("SubAccounts")
  inactiveAt   DateTime?
  createdById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  sales                    Sales[]            @relation("SaleAccount")
  salesDeposited           Sales[]            @relation("SaleDeposit")
  expenses                 Expense[]          @relation("ExpenseAccount")
  expensesPaidThrough      Expense[]          @relation("ExpensePaidThrough")
  expenseItems             ExpenseItem[]      @relation("ExpenseItemAccount")
  transactions             Transaction[]      @relation("TransactionAccount")
  recurringExpenses        RecurringExpense[] @relation("RecurringAccount")
  recurringPaidThrough     RecurringExpense[] @relation("RecurringPaidThrough")
  invoiceItems             InvoiceItem[]      @relation("InvoiceItemAccount")
  invoicePaymentsDeposited InvoicePayment[]   @relation("InvoicePaymentDeposit")
  debtPaymentsDeposited    DebtPayment[]      @relation("DebtPaymentDeposit")
  openingBalances          OpeningBalance[]
  bills                    BusinessDebt[]      @relation("BillAccount")
  billsReceivedVia         BusinessDebt[]      @relation("BillReceivedVia")
  billPaymentsPaidThrough  BillPayment[]       @relation("BillPaymentPaidThrough")
  journalLines             ManualJournalLine[] @relation("JournalLineAccount")
  itemsIncome              InventoryItem[]     @relation("ItemIncomeAccount")
  saleItems                SaleItem[]          @relation("SaleItemAccount")
  itemsPurchase            InventoryItem[]     @relation("ItemPurchaseAccount")
  itemGroupsIncome         ItemGroup[]         @relation("ItemGroupIncomeAccount")
  itemGroupsPurchase       ItemGroup[]         @relation("ItemGroupPurchaseAccount")

  @@unique([businessId, systemKey])
  @@unique([businessId, categorySlug])
  @@unique([businessId, codeKey])
  @@unique([businessId, nameKey])
  @@index([parentId])
}

// What an account held at the start of Business.openingBalanceDate (a debit or
// a credit, never both). The ledger posts the difference from what the records
// already put there, against Opening Balance Adjustments.
model OpeningBalance {
  id          String        @id @default(uuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id], onDelete: NoAction)
  debit       Float         @default(0)
  credit      Float         @default(0)
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([businessId, accountId])
  @@index([accountId])
}

// A manual journal (release 2, 2026-10-13; Adjustments in the app): the
// owner's own entry, numbered per business from Business.journalCounter
// (MJ-00001). status: draft | published (CHECK in the migration); only a
// published journal posts, on its date, and its debits equal its credits to
// the kobo (the route checks).
model ManualJournal {
  id          String              @id @default(uuid())
  businessId  String
  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number      String
  date        DateTime            @default(now())
  note        String?
  status      String              @default("draft")
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  lines       ManualJournalLine[]

  @@unique([businessId, number])
  @@index([businessId, date])
}

// One line of a manual journal: a debit or a credit, never both (one side
// more than zero, the other zero: CHECK in the migration). An account a line
// names is refused deletion. The migration makes that key DEFERRABLE
// INITIALLY DEFERRED (Prisma does not show it): checked at the end of the
// transaction, so deleting a whole business still cascades through its
// accounts and its journals' lines in one statement.
model ManualJournalLine {
  id          String        @id @default(uuid())
  journalId   String
  journal     ManualJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId   String
  account     LedgerAccount @relation("JournalLineAccount", fields: [accountId], references: [id], onDelete: NoAction)
  debit       Float         @default(0)
  credit      Float         @default(0)
  description String?
  position    Int           @default(0) // the order the owner entered the lines in

  @@index([journalId])
  @@index([accountId])
}

// A change to a goods item's stock (release 3), written only by
// utils/stock.js. kind: opening | opening_value | purchase | sale | invoice |
// credit_note | adjustment | revalue; reason (adjustments only, and always
// there): damaged | expired | lost | used | counted | other (CHECKs in the
// migration). date is the date of the record behind it. quantity and value
// (naira, kobo-exact) are signed: in is more than zero, out less; the
// value-only kinds (opening_value, revalue) move no quantity. qtyAfter and
// valueAfter are what the item held right after (for the history; a later
// removal does not rewrite them). sourceKey names the record line it belongs
// to ("sale:<saleItemId>", "inv:<invoiceItemId>", "bill:<billItemId>",
// "adj:<uuid>", "open:<itemId>:<n>"), once per business, so a retried request
// finds its movement. An item's quantity and stockValue are the sums of its
// movements.
model StockMovement {
  id          String        @id @default(uuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind        String
  reason      String?
  date        DateTime      @default(now())
  quantity    Float         @default(0)
  value       Float         @default(0)
  qtyAfter    Float         @default(0)
  valueAfter  Float         @default(0)
  sourceKey   String
  note        String?
  createdById String?
  createdAt   DateTime      @default(now())

  @@unique([businessId, sourceKey])
  @@index([businessId, date])
  @@index([itemId, createdAt])
}
